---
/**
 * Pricing `/pricing` — the two-tier spine (memory: purplelabel-plans). Platform (multi-tenant) vs
 * Enterprise (dedicated). AXIS = data sovereignty & control, NOT security level: both tiers share
 * the same audited floor (security-parity banner makes this explicit). Enterprise GA features
 * (silo, BYOK, residency, bulk export) are real per Gregg 2026-06-26. Dollar figures are still open
 * (Batch 4 grill) — page leads with "talk to sales for pricing", no invented numbers.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/layout/Section.astro';
import SectionHeader from '../components/primitives/SectionHeader.astro';
import Eyebrow from '../components/primitives/Eyebrow.astro';
import Button from '../components/primitives/Button.astro';
import Badge from '../components/primitives/Badge.astro';
import { Icon } from 'astro-icon/components';

const tiers = [
  {
    name: 'Platform',
    badge: 'Multi-tenant',
    tagline: 'The full platform, multi-tenant.',
    audience: 'For developers and teams building agent-run telemedicine.',
    points: [
      'Every module — intake, visits, e-prescribing, pharmacy, payments, analytics',
      'Developer docs, API, MCP servers, and the prompt library',
      'The durable order pipeline, built and operated for you',
      'HIPAA-compliant, encrypted infrastructure — behind the same cleared audits',
      'Pass-through Rx pricing — our cost is your cost, no markup',
    ],
    start: 'Self-serve a sandbox and API keys today; sign a BAA and onboard to go live.',
    primary: { label: 'Start building', href: '/developers' },
    secondary: { label: 'Book a consult', href: '/contact' },
    featured: true,
  },
  {
    name: 'Managed',
    badge: 'Done-for-you',
    tagline: 'We build, run, and grow it for you.',
    audience: 'For operators who want a branded telehealth business without writing code.',
    points: [
      'We build, staff, and configure your branded store end to end',
      'Licensed providers, pharmacy, and compliance handled for you',
      'Marketing and analytics support to fill your programs',
      'Pass-through Rx pricing — our cost is your cost, no markup',
      'Revenue share — we only do well when you do',
    ],
    start: 'A high-touch launch with our team — typically live in about 30 days.',
    primary: { label: 'Book a consult', href: '/contact' },
    secondary: { label: 'Explore Managed', href: '/managed' },
    featured: true,
  },
  {
    name: 'Enterprise',
    badge: 'Dedicated',
    tagline: 'Everything in Platform, on dedicated infrastructure.',
    audience: 'For organizations with sovereignty, compliance, or residency requirements.',
    points: [
      'Dedicated data silo — single-tenant deployment',
      'Per-tenant encryption keys (BYOK)',
      'Custom data residency',
      'On-demand data export & portability',
      'Everything in Platform, on the same audited foundation',
    ],
    start: 'Scoped to your compliance and procurement requirements.',
    primary: { label: 'Book a consult', href: '/contact' },
    secondary: null,
    featured: false,
  },
];

const matrix = [
  { label: 'Every platform module', platform: true, managed: true, enterprise: true },
  {
    label: 'Developer docs, API, MCP, prompt library',
    platform: true,
    managed: true,
    enterprise: true,
  },
  {
    label: 'HIPAA-compliant, encrypted, audited foundation',
    platform: true,
    managed: true,
    enterprise: true,
  },
  { label: 'Row-level tenant isolation', platform: true, managed: true, enterprise: true },
  {
    label: 'We sign a Business Associate Agreement',
    platform: true,
    managed: true,
    enterprise: true,
  },
  { label: 'Pass-through Rx pricing, no markup', platform: true, managed: true, enterprise: true },
  {
    label: 'We build, staff, and operate it for you',
    platform: false,
    managed: true,
    enterprise: false,
  },
  { label: 'Marketing & growth support', platform: false, managed: true, enterprise: false },
  { label: 'Revenue-share pricing available', platform: false, managed: true, enterprise: false },
  {
    label: 'Dedicated data silo (single-tenant)',
    platform: false,
    managed: false,
    enterprise: true,
  },
  { label: 'Per-tenant encryption keys (BYOK)', platform: false, managed: false, enterprise: true },
  { label: 'Custom data residency', platform: false, managed: false, enterprise: true },
  { label: 'Bulk data export & portability', platform: false, managed: false, enterprise: true },
];
---

<PageLayout
  title="Pricing — Platform, Enterprise, and Managed plans"
  description="Three ways to build on Purple Label MD. Platform: the full multi-tenant stack with developer docs, API, MCP, and pass-through Rx pricing. Enterprise: a dedicated data silo, per-tenant encryption keys, residency, and data portability. Managed: we build and operate your branded telehealth business for you — on the same audited foundation."
  path="/pricing"
>
  {/* Hero */}
  <Section size="lg">
    <Eyebrow>Plans</Eyebrow>
    <h1 class="mt-4 max-w-prose font-display text-display text-ink-900">
      Build it, own it, or have us run it.
    </h1>
    <p class="mt-6 max-w-prose text-body-lg text-ink-500">
      Start on the multi-tenant Platform with the full toolkit your agents need, run on dedicated
      Enterprise infrastructure with your own keys and data residency, or have our team build and
      operate the whole thing for you. Every path rides the same proven pipeline — and the same
      cleared audits.
    </p>
  </Section>

  {/* Tier cards */}
  <Section>
    <div class="grid gap-6 lg:grid-cols-3">
      {
        tiers.map((t) => (
          <div
            class:list={[
              'flex flex-col rounded-lg border bg-surface p-8',
              t.featured ? 'border-purple-300' : 'border-line',
            ]}
          >
            <div class="flex items-center gap-3">
              <h2 class="font-display text-h3 text-ink-900">{t.name}</h2>
              <Badge tone={t.featured ? 'purple' : 'neutral'}>{t.badge}</Badge>
            </div>
            <p class="mt-3 text-body-lg text-ink-700">{t.tagline}</p>
            <p class="mt-1 text-sm text-ink-400">{t.audience}</p>
            <ul class="mt-6 flex flex-col gap-3">
              {t.points.map((p) => (
                <li class="flex gap-3">
                  <Icon name="lucide:check" class="icon size-5 shrink-0 text-success" />
                  <span class="text-body text-ink-700">{p}</span>
                </li>
              ))}
            </ul>
            <p class="mt-6 text-sm text-ink-500">{t.start}</p>
            <div class="mt-8 flex flex-wrap items-center gap-4">
              <Button variant="primary" href={t.primary.href}>
                {t.primary.label}
              </Button>
              {t.secondary && (
                <Button variant="link-arrow" href={t.secondary.href}>
                  {t.secondary.label}
                </Button>
              )}
            </div>
          </div>
        ))
      }
    </div>
    <p class="mt-8 text-center text-sm text-ink-400">
      Pricing is tailored to your volume and requirements — talk to sales for a quote.
    </p>
  </Section>

  {
    /* Security-parity banner — kills the "shared = less secure" trap. Sits below the cards so it
     reassures after the tier choice rather than interrupting the heading → cards flow. */
  }
  <Section size="sm" surface="sunken" bordered>
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
      <Icon name="lucide:shield-check" class="icon size-6 shrink-0 text-success" />
      <div>
        <p class="font-display text-h4 text-ink-900">Same security floor, every tier.</p>
        <p class="mt-2 max-w-prose text-body text-ink-500">
          Enterprise isn't more secure — it's more sovereign. Every tenant gets HIPAA-compliant,
          end-to-end-encrypted infrastructure with row-level isolation, behind the same cleared
          HIPAA, pharmacy-board, and payment-processor audits. Enterprise adds dedicated
          infrastructure, your own encryption keys, and your choice of data residency.
        </p>
      </div>
    </div>
  </Section>

  {/* Comparison matrix */}
  <Section surface="surface" bordered>
    <SectionHeader
      eyebrow="Compare"
      title="What's in each plan."
      lead="Platform and Managed share the full toolkit and pass-through pricing. Enterprise adds sovereignty; Managed adds our team running the whole thing for you."
    />
    <div class="mt-12 overflow-x-auto">
      <table class="w-full border-collapse text-left">
        <thead>
          <tr class="border-b border-line">
            <th scope="col" class="py-4 pr-4 font-display text-sm font-semibold text-ink-900"
              >Capability</th
            >
            <th
              scope="col"
              class="px-4 py-4 text-center font-display text-sm font-semibold text-ink-900"
              >Platform</th
            >
            <th
              scope="col"
              class="px-4 py-4 text-center font-display text-sm font-semibold text-ink-900"
              >Managed</th
            >
            <th
              scope="col"
              class="px-4 py-4 text-center font-display text-sm font-semibold text-ink-900"
              >Enterprise</th
            >
          </tr>
        </thead>
        <tbody>
          {
            matrix.map((row) => (
              <tr class="border-b border-line">
                <th scope="row" class="py-4 pr-4 text-body font-normal text-ink-700">
                  {row.label}
                </th>
                <td class="px-4 py-4 text-center">
                  {row.platform ? (
                    <Icon name="lucide:check" class="icon mx-auto size-5 text-success" />
                  ) : (
                    <span class="text-ink-300">—</span>
                  )}
                  <span class="sr-only">{row.platform ? 'Included' : 'Not included'}</span>
                </td>
                <td class="px-4 py-4 text-center">
                  {row.managed ? (
                    <Icon name="lucide:check" class="icon mx-auto size-5 text-success" />
                  ) : (
                    <span class="text-ink-300">—</span>
                  )}
                  <span class="sr-only">{row.managed ? 'Included' : 'Not included'}</span>
                </td>
                <td class="px-4 py-4 text-center">
                  {row.enterprise ? (
                    <Icon name="lucide:check" class="icon mx-auto size-5 text-success" />
                  ) : (
                    <span class="text-ink-300">—</span>
                  )}
                  <span class="sr-only">{row.enterprise ? 'Included' : 'Not included'}</span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-8 max-w-prose text-body text-ink-500">
      The same architecture powers every tier — pooled with row-level isolation, or a dedicated silo
      with your own keys and residency. Managed runs the whole thing for you on revenue share.
    </p>
    <div class="mt-4">
      <Button variant="link-arrow" href="/architecture">See the architecture</Button>
    </div>
  </Section>

  {/* Closing CTA */}
  <Section>
    <SectionHeader
      align="center"
      eyebrow="Get started"
      title="Build on the Platform, scale on a dedicated silo, or have us run it."
    />
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <Button variant="primary" href="/contact">Book a consult</Button>
      <Button variant="secondary" href="/developers">Start building</Button>
    </div>
  </Section>
</PageLayout>
