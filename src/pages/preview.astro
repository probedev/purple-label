---
/**
 * Preview `/preview` — "See it under your brand" (Nov 2026 refresh plan
 * §4.5; a branded-preview generator that shows the whole health experience, not just a
 * storefront). The visitor types a brand name and picks a color or an audience preset, and
 * the member-app mock re-skins live.
 *
 * Client-only by design: nothing is fetched or sent anywhere (no server-side URL fetch → no
 * SSRF surface, no PII leaves the browser) until the visitor chooses "Take it live", which
 * pre-fills the existing lead modal with the brand name and color.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/layout/Section.astro';
import SectionHeader from '../components/primitives/SectionHeader.astro';
import Eyebrow from '../components/primitives/Eyebrow.astro';
import Button from '../components/primitives/Button.astro';
import Card from '../components/primitives/Card.astro';
import MemberAppMock from '../components/marketing/MemberAppMock.astro';
import { Icon } from 'astro-icon/components';
import { SOLUTIONS } from '../lib/solutions';
import { CTA } from '../lib/nav';

const presets = SOLUTIONS.map((s) => ({ audience: s.audience, ...s.example }));
const initial = presets[0];
---

<PageLayout
  title="See it under your brand — a live preview of your health experience"
  description="Type your brand name, pick a color, and see the member experience — results, health score, protocol, and orders — re-skinned as yours in seconds."
  path="/preview"
>
  <Section size="lg">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-start">
      <div class="lg:col-span-5">
        <Eyebrow>Live preview</Eyebrow>
        <h1 class="mt-4 font-display text-h1 text-ink-900">See it under your brand.</h1>
        <p class="mt-6 text-body-lg text-ink-500">
          This is the member experience your brand launches on Purple Label — results, a health
          score with your name on it, a clinician-reviewed protocol, and orders — re-skinned as you
          type.
        </p>

        <form id="preview-form" class="mt-10 flex flex-col gap-6" novalidate>
          <div>
            <label for="pv-name" class="block text-sm font-semibold text-ink-900">Brand name</label>
            <input
              id="pv-name"
              name="brand"
              type="text"
              maxlength="32"
              autocomplete="organization"
              value={initial.name}
              class="mt-2 h-11 w-full rounded-md border border-line bg-surface px-3 text-body text-ink-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-500"
            />
          </div>
          <div>
            <label for="pv-color" class="block text-sm font-semibold text-ink-900"
              >Brand color</label
            >
            <div class="mt-2 flex items-center gap-3">
              <input
                id="pv-color"
                name="color"
                type="color"
                value={initial.primary}
                class="h-11 w-16 cursor-pointer rounded-md border border-line bg-surface p-1"
              />
              <span id="pv-color-hex" class="font-mono text-sm text-ink-500">{initial.primary}</span
              >
            </div>
          </div>
          <fieldset>
            <legend class="text-sm font-semibold text-ink-900">Or start from an example</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {
                presets.map((p) => (
                  <button
                    type="button"
                    class="inline-flex h-11 items-center gap-2 rounded-md border border-line bg-surface px-3 text-sm font-medium text-ink-700 transition-colors duration-150 hover:border-purple-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-500"
                    data-preset={JSON.stringify(p)}
                  >
                    {p.audience}
                  </button>
                ))
              }
            </div>
          </fieldset>
        </form>

        <div class="mt-10 flex flex-wrap items-center gap-4">
          <Button variant="primary" href={CTA.consult.href} id="pv-take-live">
            Take it live on a call
            <Icon name="lucide:arrow-right" class="icon size-4" />
          </Button>
        </div>
        <p class="mt-4 flex items-center gap-1.5 text-xs text-ink-400">
          <Icon name="lucide:lock" class="icon size-3.5" />
          Your preview stays in your browser — nothing is sent until you choose to talk to us.
        </p>
      </div>
      <div class="lg:sticky lg:top-24 lg:col-span-7">
        <MemberAppMock brand={initial} id="pv-mock" />
      </div>
    </div>
  </Section>

  <Section surface="surface" bordered>
    <SectionHeader
      eyebrow="What you just changed"
      title="Your brand on every surface a member touches."
    />
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      <Card icon="palette" title="Your look" href="/platform/member-app">
        Logo, palette, type, and voice drive every screen — members never see ours.
      </Card>
      <Card icon="globe" title="Your domains" href="/platform/member-app">
        The member app and sign-in run on your own domains.
      </Card>
      <Card icon="gauge" title="Your score" href="/platform/insights">
        The health score, the protocols, and the AI guide all carry your name.
      </Card>
    </div>
  </Section>
</PageLayout>

<script>
  type Brand = { name: string; primary: string; tint: string; mark: string };
  // Resolved at call time: MemberAppMock's module script defines it, and module script
  // order isn't guaranteed.
  const getApply = () =>
    (window as unknown as { plApplyBrand?: (el: HTMLElement, b: Brand) => void }).plApplyBrand;

  const mock = document.getElementById('pv-mock');
  const nameEl = document.getElementById('pv-name') as HTMLInputElement | null;
  const colorEl = document.getElementById('pv-color') as HTMLInputElement | null;
  const hexEl = document.getElementById('pv-color-hex');

  /** Light tint of a hex color: mix 88% toward white. */
  const tintOf = (hex: string) => {
    const n = parseInt(hex.slice(1), 16);
    const mix = (c: number) => Math.round(c + (255 - c) * 0.88);
    const [r, g, b] = [(n >> 16) & 255, (n >> 8) & 255, n & 255].map(mix);
    return `#${((r << 16) | (g << 8) | b).toString(16).padStart(6, '0')}`;
  };
  const markOf = (name: string) => (name.trim().match(/[A-Za-z0-9]/)?.[0] ?? 'Y').toUpperCase();

  const render = () => {
    const apply = getApply();
    if (!mock || !apply || !nameEl || !colorEl) return;
    const name = nameEl.value.trim() || 'Your Brand';
    const primary = /^#[0-9a-f]{6}$/i.test(colorEl.value) ? colorEl.value : '#5a2c9e';
    if (hexEl) hexEl.textContent = primary;
    apply(mock, { name, primary, tint: tintOf(primary), mark: markOf(name) });
  };

  nameEl?.addEventListener('input', render);
  colorEl?.addEventListener('input', render);
  document.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const p = JSON.parse(btn.dataset.preset ?? '{}') as Brand;
      if (nameEl) nameEl.value = p.name;
      if (colorEl) colorEl.value = p.primary;
      render();
    }),
  );

  // Carry the preview into the lead modal (opened by LeadModal's document click handler,
  // which runs after this element-level listener).
  document.getElementById('pv-take-live')?.addEventListener('click', () => {
    const company = document.getElementById('lead-company') as HTMLInputElement | null;
    const message = document.getElementById('lead-message') as HTMLTextAreaElement | null;
    if (company && nameEl && !company.value) company.value = nameEl.value.trim();
    if (message && !message.value && nameEl && colorEl) {
      message.value = `From the live preview: "${nameEl.value.trim()}" in ${colorEl.value}.`;
    }
  });
</script>
