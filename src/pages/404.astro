---
/**
 * 404 — a real not-found page (CONTENT-REVIEW-2026-07-21 G3) so nothing on the domain
 * dead-ends in server chrome. Cloudflare's assets router serves 404.html automatically.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Eyebrow from '../components/primitives/Eyebrow.astro';
import Section from '../components/layout/Section.astro';
import Button from '../components/primitives/Button.astro';
---

<PageLayout
  title="Page not found"
  description="That page doesn't exist. Head back to Purple Label MD."
  path="/404"
  noindex={true}
  hideStickyCta
>
  <Section size="lg">
    <div class="mx-auto max-w-2xl text-center">
      <Eyebrow>404</Eyebrow>
      <h1 class="mt-4 font-display text-display text-ink-900">That page isn't here.</h1>
      <p class="mx-auto mt-6 max-w-prose text-body-lg text-ink-500">
        The link may be old, or the page may not have shipped yet. Everything that exists is one
        click away.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <Button variant="primary" href="/">Back to home</Button>
        <Button variant="secondary" href="/platform">Explore the platform</Button>
        <Button variant="ghost" href="/contact">Book a consult</Button>
      </div>
    </div>
  </Section>
</PageLayout>
