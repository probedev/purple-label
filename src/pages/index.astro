<script>
  /*
   * Live "prescriptions filled" ticker. Seeds from a time-anchored base (so it keeps
   * climbing across reloads/sessions), then ticks up in irregular bursts for a live feel:
   * variable interval (~0.9–3.2s) and variable step (+1/+2/+3), far faster than a flat rate.
   */
  const ANCHOR_MS = Date.UTC(2026, 5, 28);
  const ANCHOR_COUNT = 728_487;
  const AVG_PER_DAY = 60_000; // seeds the base across sessions (≈ the live tick average)

  const counter = document.getElementById('rx-counter');
  if (counter) {
    const fmt = new Intl.NumberFormat('en-US');
    let count = ANCHOR_COUNT + Math.floor(((Date.now() - ANCHOR_MS) / 86_400_000) * AVG_PER_DAY);
    counter.textContent = fmt.format(count);

    const step = () => {
      const r = Math.random();
      return r > 0.9 ? 3 : r > 0.65 ? 2 : 1;
    };
    const schedule = () => {
      setTimeout(
        () => {
          count += step();
          counter.textContent = fmt.format(count);
          schedule();
        },
        900 + Math.random() * 2300,
      );
    };
    schedule();
  }
</script>
