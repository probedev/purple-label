---
/**
 * Home `/` — Nov 2026 refresh (plan §4.1). Category line (Gregg
 * 2026-11-10): "The Branded Digital Health Care Experience". The vision: a white-label consumer health
 * platform — the brand gets the whole consumer health loop — labs, wearables,
 * insights, protocols, clinicians, Rx, pharmacy — under its own name, and keeps the member.
 * Telehealth is one layer of the product, not the product.
 *
 * Arc: category + branded member app → proof → the shift → the health loop → who builds →
 * the member is yours (category comparison, no competitor names) → you bring / we run →
 * two ways to run it → care programs → prescribed from data → privacy → developers → FAQ.
 *
 * All numbers route through src/lib/stats.ts (G1). Mock brands are fictional and labeled.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/layout/Section.astro';
import SectionHeader from '../components/primitives/SectionHeader.astro';
import { Icon } from 'astro-icon/components';
import Button from '../components/primitives/Button.astro';
import Card from '../components/primitives/Card.astro';
import StatCard from '../components/primitives/StatCard.astro';
import FAQ from '../components/primitives/FAQ.astro';
import Eyebrow from '../components/primitives/Eyebrow.astro';
import Heritage from '../components/marketing/Heritage.astro';
import HealthLoop from '../components/marketing/HealthLoop.astro';
import MemberAppMock from '../components/marketing/MemberAppMock.astro';
import { organizationJsonLd, softwareApplicationJsonLd, faqJsonLd } from '../lib/seo';
import { STATS, RX_ODOMETER } from '../lib/stats';
import { DOCS_URL, CTA } from '../lib/nav';
import { SOLUTIONS, HERO_MOCK_BRANDS } from '../lib/solutions';
import { PROGRAMS_DATA } from '../lib/programs';

/** StatCard props from a registry entry — no literal stats in this file (G1). */
const stat = (key: keyof typeof STATS) => ({
  value: STATS[key].value,
  label: STATS[key].label,
  caption: STATS[key].caption,
});

const RX_ANCHOR = RX_ODOMETER.anchorCount;

// "The member is yours" — category comparison. Column labels are categories, never
// competitor names (guardrail §6.2).
const compareCols = ['Rx storefront vendor', 'Consumer health app', 'Your brand on Purple Label'];
const compareRows: { label: string; cells: [string, string, string] }[] = [
  { label: 'Whose brand the member sees', cells: ['Yours', 'Theirs', 'Yours'] },
  { label: 'Who owns the member relationship and data', cells: ['Yours', 'Theirs', 'Yours'] },
  { label: 'Labs and biomarkers', cells: ['—', '✓', '✓'] },
  { label: 'Wearables and a longitudinal record', cells: ['—', '✓', '✓'] },
  { label: 'Personalized, clinician-reviewed protocols', cells: ['—', '✓', '✓'] },
  { label: 'Licensed clinicians and e-prescribing', cells: ['✓', '✓', '✓'] },
  { label: '503A/503B pharmacy at pass-through pricing', cells: ['Varies', '—', '✓'] },
  { label: 'A public API, webhooks, and your own front end', cells: ['Limited', '—', '✓'] },
  { label: 'Run it yourself, or have it run for you', cells: ['Run for you', '—', 'Both'] },
];

const youBring = [
  'Your brand and your audience',
  'Your retail pricing and product mix',
  'Your voice, your protocols, your marketing',
  'The relationship with your members',
];
const weRun = [
  'Labs, devices, and the longitudinal record',
  'Licensed clinicians in all 50 states',
  'Pharmacy, packaging, and delivery',
  'Payments, compliance, and certification support',
  'The member app, the console, and the API',
];

const featuredPrograms = ['weight-loss', 'trt', 'womens-health', 'peptides', 'labs', 'hair-skin']
  .map((slug) => PROGRAMS_DATA.find((p) => p.slug === slug))
  .filter(Boolean) as typeof PROGRAMS_DATA;

const safety = [
  {
    icon: 'clipboard-list',
    title: 'Governed intake',
    body: 'Your brand shapes the screening; a physician-governed medical questionnaire marketing can never rewrite.',
  },
  {
    icon: 'microscope',
    title: 'Lab-informed decisions',
    body: 'Results flow into eligibility and review, so programs like TRT and HRT start from data.',
  },
  {
    icon: 'scale',
    title: 'Versioned rules',
    body: 'Eligibility and dose rules run as code — every decision versioned, explainable, and replayable.',
  },
  {
    icon: 'user-check',
    title: 'Clinicians decide',
    body: 'Independent licensed clinicians make every clinical and prescribing decision. Always.',
  },
];

const privacy = [
  {
    icon: 'key-round',
    title: 'A key for every member',
    body: 'Health data is encrypted per member. Erasure is provable — destroy the key, the data is gone.',
  },
  {
    icon: 'building',
    title: 'Tenant isolation',
    body: 'Every brand is isolated by design; another tenant’s data doesn’t just stay hidden — it doesn’t exist to them.',
  },
  {
    icon: 'eye-off',
    title: 'PHI stays put',
    body: 'Events, webhooks, and status reads carry references, never health data.',
  },
  {
    icon: 'scroll-text',
    title: 'Audit that fails closed',
    body: 'Every sensitive read is audited — and if the audit can’t be written, the read doesn’t happen.',
  },
];

const apiSample = `GET /v1/journeys/jny_8k2c…/status
X-Brand-Id: brd_northline

200 OK
{
  "public_status": "SHIPPED",
  "status_version": "v1"
}

→ webhook  journey.shipment.shipped.v1
   X-Purple-Signature: v1=9f3a…`;

const homeFaqs = [
  {
    q: 'What is Purple Label MD?',
    a: 'A white-label digital health platform. Brands launch a complete consumer health experience — labs, wearables, insights, protocols, licensed clinicians, prescriptions, and pharmacy — under their own name, on one platform.',
  },
  {
    q: 'Is this a telehealth platform?',
    a: 'Telehealth is one layer of it. Members also get labs and biomarkers, connected devices, a health score, and personalized protocols — the longitudinal experience consumers expect, with care and prescriptions when they need them.',
  },
  {
    q: 'Do I own my brand, members, and data?',
    a: 'Yes — always. Purple Label runs the platform underneath; the brand, the member relationship, and the data stay with you. We never sell member data.',
  },
  {
    q: 'Am I the doctor?',
    a: 'No. Independent licensed clinicians, credentialed in all 50 states, make every clinical and prescribing decision. You own the brand; licensed providers handle the medicine.',
  },
  {
    q: 'Who is it for?',
    a: 'Anyone with a relationship to their members’ health: DTC health brands, gyms and fitness brands, clinics and med spas, employers and benefits platforms, creators and physicians, wellness brands, and pharmacies.',
  },
  {
    q: 'What care programs are supported?',
    a: 'Weight loss (GLP-1), TRT, HRT, men’s and women’s health, peptides and longevity, hair and skin, sexual health, and lab-led programs — plus custom formulations with our 503A/503B partners.',
  },
  {
    q: 'Do I build it myself, or is it run for me?',
    a: 'Either. Build on the platform with your team and your agents through the API and site kit, or have our team build and operate it for you on the Managed plan.',
  },
  {
    q: 'How does LegitScript certification work?',
    a: 'As a LegitScript Enterprise Partner, certification support is built into every launch — so your brand can advertise and process payments with confidence.',
  },
];
---

<PageLayout
  title="Purple Label MD — the branded digital health care experience"
  description="Launch a complete consumer health experience under your brand: labs and biomarkers, wearables, insights, protocols, licensed clinicians, prescriptions, and pharmacy — one platform, and the member is yours."
  path="/"
  jsonLd={[organizationJsonLd(), softwareApplicationJsonLd(), faqJsonLd(homeFaqs)]}
>
  {/* 1 — Hero: category + the branded member app, cycling through illustrative brands. */}
  <Section size="lg">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-14">
      <div class="lg:col-span-6">
        <Eyebrow>The white-label health platform</Eyebrow>
        {
          /* Explicit {' '} — Astro collapses the newline before the span (shipped as
            "brandedtelehealth" once on the live hero). */
        }
        <h1 class="mt-5 font-display text-h1 text-ink-900">
          The branded{' '}
          <span class="text-purple-600">digital health care experience.</span>
        </h1>
        <p class="mt-6 max-w-prose text-body-lg text-ink-500">
          Labs and biomarkers, wearables, personalized protocols, licensed clinicians,
          prescriptions, and pharmacy — one consumer-grade health platform, launched under your
          name. Build on it with your team, or have us run it for you. Either way, the member is
          yours.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <Button variant="primary" href={CTA.consult.href}>{CTA.consult.label}</Button>
          <Button variant="secondary" href={CTA.preview.href}>
            <Icon name="lucide:palette" class="icon size-4 text-purple-600" />
            {CTA.preview.label}
          </Button>
        </div>
        <ul class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-ink-400">
          <li class="inline-flex items-center gap-1.5">
            <Icon name="lucide:shield-check" class="icon size-4 shrink-0 text-success" />
            LegitScript Enterprise Partner
          </li>
          <li class="inline-flex items-center gap-1.5">
            <Icon name="lucide:check" class="icon size-4 shrink-0 text-success" />
            HIPAA-compliant
          </li>
          <li class="inline-flex items-center gap-1.5">
            <Icon name="lucide:check" class="icon size-4 shrink-0 text-success" />
            50-state clinician network
          </li>
        </ul>
      </div>
      <div class="lg:col-span-6">
        <MemberAppMock brand={HERO_MOCK_BRANDS[0]} cycle={HERO_MOCK_BRANDS} />
      </div>
    </div>
  </Section>

  {/* 2 — Scale strip (operators' heritage, registry-driven) */}
  <Section size="sm" surface="surface" bordered>
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <StatCard {...stat('rxMonthly')} />
      <StatCard {...stat('providerNetwork')} />
      <StatCard {...stat('brandsLaunched')} />
      <StatCard {...stat('legitscriptCerts')} />
    </div>
    <p
      class="mt-8 flex flex-wrap items-baseline justify-center gap-x-2 text-center text-xs uppercase tracking-eyebrow text-ink-400"
    >
      <span>Rx filled by our operators' platforms to date</span>
      <span
        id="rx-counter"
        class="font-mono text-sm tabular-nums tracking-normal text-purple-600 normal-case"
        >{RX_ANCHOR.toLocaleString('en-US')}</span
      >
    </p>
  </Section>

  {/* 3 — The shift */}
  <Section>
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <SectionHeader
          eyebrow="The shift"
          title="Telehealth sold a prescription. Consumers want a health relationship."
        />
      </div>
      <div class="flex flex-col gap-6 lg:col-span-7">
        <p class="text-body-lg text-ink-500">
          The first wave of digital health was a storefront: a questionnaire, a prescription, a
          refill. Today’s health consumers expect more — their labs, their devices, a score they can
          move, a plan that adapts, and care when they need it, in one place they trust.
        </p>
        <p class="text-body-lg text-ink-500">
          The consumer apps that deliver it keep the member for themselves. Purple Label gives that
          whole experience to you — so the gym, the clinic, the creator, the employer, and the
          health brand your members already trust can be the place they go for their health.
        </p>
      </div>
    </div>
  </Section>

  {/* 4 — The health loop */}
  <Section surface="surface" bordered>
    <SectionHeader
      eyebrow="The platform"
      title="One platform for the whole health loop."
      lead="Know every member. Understand what their data means. Act on it with real care. Then retest, track, and do it again — all under your brand."
    />
    <div class="mt-14">
      <HealthLoop centerLabel="Your brand" />
    </div>
  </Section>

  {/* 5 — Who builds */}
  <Section>
    <SectionHeader
      eyebrow="Who builds on Purple Label"
      title="If your members trust you with their health, this is your platform."
      lead="Every audience that already influences how people eat, train, recover, and age can now deliver the care itself — under its own name."
    />
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        SOLUTIONS.map((s) => (
          <a
            href={`/solutions/${s.slug}`}
            class="flex flex-col rounded-lg border border-line bg-surface p-6 transition duration-150 ease-out hover:border-purple-200 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-500"
          >
            <Icon name={`lucide:${s.icon}`} class="icon size-6 text-purple-600" />
            <span class="mt-4 font-display text-h4 text-ink-900">{s.audience}</span>
            <span class="mt-2 flex-1 text-sm text-ink-500">{s.navDesc}</span>
            <span class="mt-4 font-mono text-xs text-ink-400">e.g. {s.example.name}</span>
          </a>
        ))
      }
      <a
        href="/preview"
        class="flex flex-col justify-between rounded-lg border border-purple-200 bg-purple-50 p-6 transition duration-150 ease-out hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-500"
      >
        <Icon name="lucide:palette" class="icon size-6 text-purple-600" />
        <span class="mt-4 font-display text-h4 text-ink-900">Your brand here</span>
        <span class="mt-2 flex-1 text-sm text-ink-500"
          >See the member experience in your name and colors — in seconds.</span
        >
        <span class="mt-4 text-sm font-semibold text-purple-600">Try the preview →</span>
      </a>
    </div>
    <p class="mt-4 text-xs text-ink-300">Example brand names are illustrative.</p>
  </Section>

  {/* 6 — The member is yours */}
  <Section surface="sunken" bordered>
    <SectionHeader
      eyebrow="The member is yours"
      title="The full consumer health experience — without giving away the member."
      lead="Storefront vendors give you a prescription funnel. Consumer health apps give you a referral link to their brand. Purple Label gives you the whole experience, and the relationship that comes with it."
    />
    <div class="mt-12 overflow-x-auto rounded-lg border border-line bg-surface">
      <table class="w-full min-w-176 text-left text-sm">
        <thead>
          <tr class="border-b border-line">
            <th scope="col" class="p-4 font-semibold text-ink-400"
              ><span class="sr-only">Capability</span></th
            >
            {
              compareCols.map((c, i) => (
                <th
                  scope="col"
                  class:list={[
                    'p-4 font-display text-sm font-semibold',
                    i === 2 ? 'bg-purple-50 text-purple-700' : 'text-ink-700',
                  ]}
                >
                  {c}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          {
            compareRows.map((r) => (
              <tr>
                <th scope="row" class="p-4 font-medium text-ink-700">
                  {r.label}
                </th>
                {r.cells.map((cell, i) => (
                  <td
                    class:list={[
                      'p-4',
                      i === 2 ? 'bg-purple-50 font-semibold text-purple-700' : 'text-ink-500',
                    ]}
                  >
                    {cell === '✓' ? (
                      <Icon name="lucide:check" class="icon size-4 text-success" aria-label="Yes" />
                    ) : cell === '—' ? (
                      <span aria-label="No" class="text-ink-300">
                        —
                      </span>
                    ) : (
                      cell
                    )}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-xs text-ink-300">
      Category comparison based on typical offerings; individual providers vary.
    </p>
  </Section>

  {/* 7 — You bring / We run */}
  <Section>
    <SectionHeader
      align="center"
      eyebrow="Division of labor"
      title="You bring the brand. We run the rest."
    />
    <div class="mx-auto mt-12 grid max-w-4xl gap-6 md:grid-cols-2">
      <div class="rounded-lg border border-line bg-surface p-6 sm:p-8">
        <p class="text-xs font-semibold uppercase tracking-eyebrow text-ink-400">You bring</p>
        <ul class="mt-5 flex flex-col gap-3">
          {
            youBring.map((t) => (
              <li class="flex items-start gap-2.5 text-body text-ink-700">
                <Icon name="lucide:check" class="icon mt-1 size-4 shrink-0 text-purple-600" />
                {t}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="rounded-lg border border-purple-200 bg-purple-50 p-6 sm:p-8">
        <p class="text-xs font-semibold uppercase tracking-eyebrow text-purple-700">We run</p>
        <ul class="mt-5 flex flex-col gap-3">
          {
            weRun.map((t) => (
              <li class="flex items-start gap-2.5 text-body text-ink-700">
                <Icon name="lucide:check" class="icon mt-1 size-4 shrink-0 text-success" />
                {t}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  {/* 8 — Two ways to run it */}
  <Section surface="surface" bordered>
    <SectionHeader
      eyebrow="Two ways to launch"
      title="Build it yourself, or have us run it."
      lead="Same platform, same clinicians, same pass-through pharmacy pricing — you choose how hands-on you want to be."
    />
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      <Card icon="code" title="Build on the platform">
        Your team and your AI agents work from a contract-first API, signed webhooks, agent-ready
        docs, and a site kit — compose exactly the experience you want, on any front end.
        <span class="mt-6 block">
          <Button variant="link-arrow" href="/developers">Explore the developer platform</Button>
        </span>
      </Card>
      <Card icon="headset" title="We run it for you">
        Prefer done-for-you? Our team builds, launches, and operates your branded health business —
        clinicians, pharmacy, compliance, and growth handled — typically live in {
          STATS.launchDays.value
        }.
        <span class="mt-6 block">
          <Button variant="link-arrow" href="/managed">Explore Managed</Button>
        </span>
      </Card>
    </div>
  </Section>

  {/* 9 — Care programs */}
  <Section>
    <SectionHeader
      eyebrow="Care programs"
      title="Launch the care your members are already looking for."
      lead="Clinician-led programs that plug into the loop — lab-informed, protocol-driven, and fulfilled at pass-through pricing. Launch one, or a full menu."
    />
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        featuredPrograms.map((p) => (
          <Card icon={p.icon} title={p.title} href={`/programs/${p.slug}`}>
            {p.cardBody}
          </Card>
        ))
      }
    </div>
    <div class="mt-8">
      <Button variant="link-arrow" href="/programs">See every care program</Button>
    </div>
  </Section>

  {/* 10 — Prescribed from data */}
  <Section surface="sunken" bordered>
    <SectionHeader
      eyebrow="Clinical safety"
      title="Prescribed from data, not just a questionnaire."
      lead="The consumer experience is yours to design. The medicine underneath is governed — by rules that run as code and clinicians who make every call."
    />
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        safety.map((s) => (
          <Card icon={s.icon} title={s.title}>
            {s.body}
          </Card>
        ))
      }
    </div>
  </Section>

  {/* 11 — Heritage */}
  <Section>
    <Heritage />
  </Section>

  {/* 12 — Privacy by architecture */}
  <Section surface="surface" bordered>
    <SectionHeader
      eyebrow="Privacy by architecture"
      title="Health data deserves better than a privacy policy."
      lead="Protection isn’t a promise layered on top — it’s how the platform is built."
    />
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        privacy.map((s) => (
          <Card icon={s.icon} title={s.title}>
            {s.body}
          </Card>
        ))
      }
    </div>
    <div class="mt-8">
      <Button variant="link-arrow" href="/security">How we protect member data</Button>
    </div>
  </Section>

  {/* 13 — Built to build on */}
  <Section>
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <SectionHeader
          eyebrow="Developer platform"
          title="Every part of the experience is programmable."
          lead="One contract-first API for intake, checkout, brand configuration, offerings, and journey status — with signed webhooks for every step. Docs generated from the same contracts the platform runs on."
        />
        <div class="mt-8 flex flex-wrap gap-4">
          <Button variant="secondary" href={DOCS_URL}>Read the docs</Button>
          <Button variant="link-arrow" href="/developers">Developer platform</Button>
        </div>
      </div>
      <div>
        <pre
          class="overflow-x-auto rounded-lg border border-line bg-surface-sunken p-6 font-mono text-sm text-ink-700"><code>{apiSample}</code></pre>
      </div>
    </div>
  </Section>

  {/* 14 — FAQ */}
  <Section surface="surface" bordered>
    <SectionHeader
      align="center"
      eyebrow="Questions, answered"
      title="The essentials, before you launch."
    />
    <FAQ class="mt-12" items={homeFaqs} />
  </Section>

  {/* 15 — Closing CTA */}
  <Section>
    <SectionHeader
      align="center"
      eyebrow="Get started"
      title="Give your members a health experience with your name on it."
      lead="See the member app, the console, and the care programs — with your brand on all of it."
    />
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <Button variant="primary" href={CTA.consult.href}>{CTA.consult.label}</Button>
      <Button variant="secondary" href={CTA.preview.href}>{CTA.preview.label}</Button>
    </div>
  </Section>
</PageLayout>

<script>
  /*
   * Live "prescriptions filled" ticker (operators' heritage — RX_ODOMETER in stats.ts).
   * Seeds from a time-anchored base, then ticks up in irregular bursts.
   */
  import { RX_ODOMETER } from '../lib/stats';

  const counter = document.getElementById('rx-counter');
  if (counter) {
    const fmt = new Intl.NumberFormat('en-US');
    let count =
      RX_ODOMETER.anchorCount +
      Math.floor(((Date.now() - RX_ODOMETER.anchorDateUtc) / 86_400_000) * RX_ODOMETER.avgPerDay);
    counter.textContent = fmt.format(count);
    const step = () => {
      const r = Math.random();
      return r > 0.9 ? 3 : r > 0.65 ? 2 : 1;
    };
    const schedule = () => {
      setTimeout(
        () => {
          count += step();
          counter.textContent = fmt.format(count);
          schedule();
        },
        900 + Math.random() * 2300,
      );
    };
    schedule();
  }
</script>
