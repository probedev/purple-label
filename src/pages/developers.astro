---
/**
 * Developers `/developers` — the programmable spine (sitemap.md §10, content.md §10).
 * Anchored sections (#api-reference, #agent-ready-docs, #mcp-servers, #prompt-library,
 * #webhooks, #integrations) match the Developers mega-menu in lib/nav.ts.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/layout/Section.astro';
import SectionHeader from '../components/primitives/SectionHeader.astro';
import Eyebrow from '../components/primitives/Eyebrow.astro';
import Button from '../components/primitives/Button.astro';
import Card from '../components/primitives/Card.astro';
import Badge from '../components/primitives/Badge.astro';
import { Icon } from 'astro-icon/components';

const pillars = [
  { label: 'API reference', href: '#api-reference' },
  { label: 'Agent-ready docs', href: '#agent-ready-docs' },
  { label: 'MCP servers', href: '#mcp-servers' },
  { label: 'Prompt library', href: '#prompt-library' },
];

const docBullets = [
  'Machine-readable and example-rich — every endpoint shows a working call.',
  'Addressable: each resource, field, and error has a stable URL your agents can cite.',
  'Written to be consumed by an agent first, skimmed by a human second.',
];
// G7 tense discipline: MCP is an at-launch capability — future-framed, no
// present-tense mechanics.
const mcpBullets = [
  'Your agents will connect to the platform over the Model Context Protocol at launch.',
  'No scraping docs, no bespoke glue code — the tools will be typed and discoverable.',
  'Scoped to the same tokens and environments as the REST API.',
];
const promptBullets = [
  'A curated, customizable prompt for building and operating each module.',
  'Your agents’ starting playbook — fork it, tailor it to your brand, version it.',
  'Covers intake assembly, visit triage, fulfillment ops, reporting, and more.',
];

// E16 — the contract guarantees, not generic API marketing.
const apiGuarantees = [
  'Published rate limits — no guessing what the platform will tolerate.',
  'Idempotency keys on mutating calls, with documented 409 conflict semantics.',
  'Cursor pagination and one consistent error envelope across every module.',
  'Versioned endpoints and events — semver, with a published changelog.',
];

// E17 — the entry-link story (a real contract), not an invented endpoint shape.
const apiSample = `# A branded entry link — offering, prefill,
# and promo context carried into hosted intake
https://start.yourbrand.com/glp-1
  ?offering=weight-management
  &promo=SPRING24
  &prefill=<signed token>

# The journey comes back to you as events
GET /v1/orders/ord_9f3a.../status
200 OK
{ "status": "VISIT_SCHEDULED", "version": 3 }`;

const webhookSample = `POST https://yourbrand.com/webhooks
X-PL-Signature: t=1789041600,v1=5f8a1c9e...
{
  "event": "visit.completed",
  "data": {
    "visit_id": "vst_3p9d...",
    "patient_id": "pat_77a1..."
  }
}`;
---

<PageLayout
  title="Developers — build and run telemedicine with your own agents"
  description="Purple Label MD is programmable end to end. API reference, agent-ready docs, MCP servers, a prompt library, and webhooks so your AI agents can stand up, operate, and extend a telemedicine business."
  path="/developers"
>
  {/* Hero */}
  <Section size="lg">
    <Eyebrow>Developers</Eyebrow>
    <h1 class="mt-4 max-w-prose font-display text-display text-ink-900">
      Build and run telemedicine with your own agents.
    </h1>
    <p class="mt-6 max-w-prose text-body-lg text-ink-500">
      Everything in Purple Label MD is programmable. Point your AI agents at our API, agent-ready
      docs, and agent pack, and they can stand up intake, visits, prescribing, pharmacy, payments,
      and analytics — then operate and extend it. This is the spine of the platform, not a side door
      — the same API our own storefronts and internal agents run on.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <Button variant="primary" href="/contact">Request API access</Button>
      <Button variant="link-arrow" href="#api-reference">Jump to the API</Button>
    </div>
    <p class="mt-4 text-sm text-ink-400">
      We provision sandbox tenants and API keys with your consult.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      {
        pillars.map((p) => (
          <a
            href={p.href}
            class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1 text-xs font-semibold text-ink-700 transition-colors duration-150 hover:border-purple-200 hover:text-purple-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-500"
          >
            <Icon name="lucide:arrow-down-right" class="icon size-3.5 text-purple-600" />
            {p.label}
          </a>
        ))
      }
    </div>
  </Section>

  {/* API reference */}
  <Section id="api-reference" surface="surface" bordered>
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <SectionHeader
          eyebrow="API reference"
          title="One programmable surface for every module."
          lead="REST endpoints for intake, visits, prescribing, pharmacy, payments, and analytics — with the contract guarantees that make a regulated platform safe to automate against."
        />
        <ul class="mt-6 space-y-3 text-body text-ink-500">
          {
            apiGuarantees.map((g) => (
              <li class="flex gap-3">
                <Icon name="lucide:check" class="icon mt-1 size-4 shrink-0 text-teal-500" />
                {g}
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <pre
          class="overflow-x-auto rounded-lg border border-line bg-surface-sunken p-6 font-mono text-sm text-ink-700"><code>{apiSample}</code></pre>
        <p class="mt-3 text-sm text-ink-400">
          Shapes shown are illustrative until the public reference is live — request API access and
          we'll provision a sandbox with your consult.
        </p>
      </div>
    </div>
  </Section>

  {/* Agent-ready docs */}
  <Section id="agent-ready-docs">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <SectionHeader
          eyebrow="Agent-ready docs"
          title="Documentation your agents can act on."
          lead="Docs structured for AI agents to consume and execute against — not a PDF your team has to translate."
        />
      </div>
      <Card icon="terminal" title="Built for machine consumption">
        <ul class="mt-2 space-y-3">
          {
            docBullets.map((b) => (
              <li class="flex gap-3">
                <Icon name="lucide:check" class="icon mt-1 size-4 shrink-0 text-teal-500" />
                {b}
              </li>
            ))
          }
        </ul>
      </Card>
    </div>
  </Section>

  {/* MCP servers */}
  <Section id="mcp-servers" surface="surface" bordered>
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
      <Card icon="server" title="Connect agents directly">
        <ul class="mt-2 space-y-3">
          {
            mcpBullets.map((b) => (
              <li class="flex gap-3">
                <Icon name="lucide:check" class="icon mt-1 size-4 shrink-0 text-teal-500" />
                {b}
              </li>
            ))
          }
        </ul>
      </Card>
      <div>
        <SectionHeader
          eyebrow="MCP servers"
          title="Your agents, plugged straight into the platform."
          lead="Connect over the Model Context Protocol and skip the integration layer entirely. Ships at launch."
        />
        <div class="mt-6">
          <Badge tone="success" icon="badge-check">Available at launch</Badge>
        </div>
      </div>
    </div>
  </Section>

  {/* Prompt library */}
  <Section id="prompt-library">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <SectionHeader
          eyebrow="Prompt library"
          title="A starting playbook for every module."
          lead="Curated, customizable prompts that get your agents productive on day one, with MCP connectors following at launch — a playbook first, then a socket."
        />
        <div class="mt-6">
          <Badge tone="success" icon="badge-check">Available at launch</Badge>
        </div>
      </div>
      <Card icon="sparkles" title="Fork, tailor, version">
        <ul class="mt-2 space-y-3">
          {
            promptBullets.map((b) => (
              <li class="flex gap-3">
                <Icon name="lucide:check" class="icon mt-1 size-4 shrink-0 text-teal-500" />
                {b}
              </li>
            ))
          }
        </ul>
      </Card>
    </div>
  </Section>

  {/* Webhooks */}
  <Section id="webhooks" surface="surface" bordered>
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <SectionHeader
          eyebrow="Webhooks & events"
          title="Automate everything else."
          lead="Subscribe to platform events and let your agents and systems react in real time — with the delivery guarantees that let you stop worrying about missed events."
        />
        <ul class="mt-6 space-y-3 text-body text-ink-500">
          <li class="flex gap-3">
            <Icon name="lucide:check" class="icon mt-1 size-4 shrink-0 text-teal-500" />
            HMAC-signed deliveries, with key rotation.
          </li>
          <li class="flex gap-3">
            <Icon name="lucide:check" class="icon mt-1 size-4 shrink-0 text-teal-500" />
            Retries with backoff, a dead-letter queue, and replay.
          </li>
          <li class="flex gap-3">
            <Icon name="lucide:check" class="icon mt-1 size-4 shrink-0 text-teal-500" />
            Per-client subscriptions, in thin or full payload modes.
          </li>
        </ul>
        <p class="mt-6 text-body text-ink-500">
          Events include <code class="font-mono text-sm text-ink-700">patient.qualified</code>,
          <code class="font-mono text-sm text-ink-700">order.created</code>,
          <code class="font-mono text-sm text-ink-700">visit.completed</code>,
          <code class="font-mono text-sm text-ink-700">rx.prescribed</code>, and
          <code class="font-mono text-sm text-ink-700">shipment.updated</code>.
        </p>
      </div>
      <div>
        <pre
          class="overflow-x-auto rounded-lg border border-line bg-surface-sunken p-6 font-mono text-sm text-ink-700"><code>{webhookSample}</code></pre>
        <p class="mt-3 text-sm text-ink-400">Illustrative payload.</p>
      </div>
    </div>
  </Section>

  {/* Environments / tokens / versioning */}
  <Section>
    <SectionHeader
      eyebrow="Built to build on"
      title="Environments, tokens, and versioning."
      lead="The boring guarantees that make a platform safe to automate against."
    />
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      <Card icon="layers" title="Sandbox & production">
        Develop and test against a full sandbox tenant — provisioned with your consult — then
        promote to production with the same calls.
      </Card>
      <Card icon="key" title="Scoped tokens">
        Issue least-privilege tokens per environment, per agent, per integration.
      </Card>
      <Card icon="git-branch" title="Versioned API">
        Pinned versions and a published changelog, so upgrades never surprise your agents.
      </Card>
    </div>
  </Section>

  {/* Integrations teaser */}
  <Section id="integrations" surface="sunken" bordered>
    <div class="grid gap-6 md:grid-cols-3">
      <Card icon="plug" title="Connect the rest of your stack" href="#webhooks">
        Pharmacies, providers, labs, analytics, and CRMs — wired through the same API and webhooks
        your agents already use.
      </Card>
      <Card
        icon="badge-check"
        title="On infrastructure that's cleared the reviews"
        href="/security"
      >
        Build on a HIPAA-compliant data layer with end-to-end encryption, behind cleared HIPAA,
        state pharmacy-board, and payment-processor reviews.
      </Card>
      <Card icon="git-merge" title="See under the hood" href="/architecture">
        The patient journey and the durable order saga your agents drive — the architecture behind
        every call.
      </Card>
    </div>
  </Section>

  {/* Closing CTA */}
  <Section surface="surface" bordered>
    <SectionHeader
      align="center"
      eyebrow="Get started"
      title="Point your agents at the platform and build."
    />
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <Button variant="primary" href="/contact">Request API access</Button>
      <Button variant="secondary" href="/contact">Talk to sales</Button>
    </div>
  </Section>
</PageLayout>
