---
/**
 * Developers `/developers` — Nov 2026 refresh (plan §4.6). Mirrors the
 * public docs at docs.purplelabelmd.com at marketing altitude: one contract-first API,
 * signed reference-only webhooks, three ways to build a front end, and the agent tooling
 * (agent-ready docs, MCP, prompt library) kept as forward-looking sections per the refresh
 * defaults. Anchors (#api, #webhooks, #front-ends, #agents) match the Developers menu.
 *
 * The patient-journey diagram (HeroArt) moved here from the old home hero; its button
 * plays the journey and its chips use the real journey.*.v1 event names.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/layout/Section.astro';
import SectionHeader from '../components/primitives/SectionHeader.astro';
import Eyebrow from '../components/primitives/Eyebrow.astro';
import Button from '../components/primitives/Button.astro';
import Card from '../components/primitives/Card.astro';
import HeroArt from '../components/marketing/HeroArt.astro';
import { Icon } from 'astro-icon/components';
import { DOCS_URL, CTA } from '../lib/nav';

const surfaces = [
  {
    icon: 'clipboard-list',
    title: 'Intake',
    body: 'Server-driven, one-question-at-a-time intake: resolve a journey, submit answers, and let the platform own sequence, branching, and completion.',
  },
  {
    icon: 'credit-card',
    title: 'Checkout & orders',
    body: 'Create hosted checkout sessions, read payment status, and reconcile every order.',
  },
  {
    icon: 'route',
    title: 'Journey status',
    body: 'One stable public status vocabulary — from received and in review to shipped, delivered, and refill due.',
  },
  {
    icon: 'palette',
    title: 'Brand configuration',
    body: 'Brand identity, sign-in and member domains, and browser origins — managed with your own key.',
  },
  {
    icon: 'package',
    title: 'Offerings & pricing',
    body: 'Enable offerings, set prices, publish screening questions, and read exactly what still blocks each one from selling.',
  },
  {
    icon: 'rocket',
    title: 'Onboarding',
    body: 'Track every step from contract to go-live, programmatically.',
  },
];

const guarantees = [
  {
    icon: 'key-round',
    title: 'Tenancy from the key',
    body: 'Your tenant is resolved from your credentials, never the request body. Another tenant’s resources answer 404 — indistinguishable from not existing.',
  },
  {
    icon: 'repeat',
    title: 'Idempotent where money moves',
    body: 'Idempotency keys on checkout and pricing writes: a replay returns the original result; a different body is a conflict, never a second charge.',
  },
  {
    icon: 'triangle-alert',
    title: 'Typed errors',
    body: 'RFC 7807 problem details with stable, documented types your code can branch on.',
  },
  {
    icon: 'git-compare',
    title: 'Contract-first',
    body: 'The docs are generated from the same contracts the platform runs on, and the changelog is generated from contract diffs.',
  },
  {
    icon: 'globe-lock',
    title: 'Browser-safe keys',
    body: 'A secret server key for your back end, and a read-only publishable key scoped to one brand for the browser.',
  },
  {
    icon: 'flask-conical',
    title: 'A real test environment',
    body: 'Build end to end against a full test environment with an interactive playground, then go live at launch.',
  },
];

const events = [
  'journey.intake.submitted.v1',
  'journey.eligibility.evaluated.v1',
  'journey.identity.verified.v1',
  'journey.case.opened.v1',
  'journey.visit.completed.v1',
  'journey.payment.succeeded.v1',
  'journey.rx.transmitted.v1',
  'journey.shipment.shipped.v1',
  'journey.shipment.delivered.v1',
  'onboarding.step.completed.v1',
];

const frontEnds = [
  {
    icon: 'layout-template',
    title: 'The site kit',
    body: 'Fork a production-ready storefront wired to the platform, then make it yours.',
  },
  {
    icon: 'wand-sparkles',
    title: 'AI-built storefronts',
    body: 'Connect a storefront built with an AI site builder using our guide and reusable prompt.',
  },
  {
    icon: 'code',
    title: 'Fully headless',
    body: 'Call the API from any stack — web, mobile, or your existing app.',
  },
];

const agents = [
  {
    icon: 'book-open',
    title: 'Agent-ready docs',
    body: 'Machine-readable docs with a curated index, so an agent working only from the docs can build a complete integration.',
  },
  {
    icon: 'plug',
    title: 'MCP servers',
    body: 'Connect your agents to the platform over the Model Context Protocol — role-scoped, audited, and read-first.',
  },
  {
    icon: 'sparkles',
    title: 'Prompt library',
    body: 'Customizable prompts for building and operating each module — a starting playbook your agents tailor.',
  },
];

const sample = `POST /v1/payments/checkout-sessions
Authorization: Bearer pk_test_…
X-Brand-Id: brd_northline
Idempotency-Key: 7c1e…

201 Created
{ "url": "https://app.northline.com/checkout/…" }

GET /v1/journeys/jny_8k2c…/status
200 OK
{ "public_status": "IN_REVIEW", "status_version": "v1" }`;
---

<PageLayout
  title="Developers — build your health experience on the Purple Label API"
  description="One contract-first API for intake, checkout, journey status, brand configuration, and offerings — with signed webhooks, typed errors, idempotency, a test environment, and agent-ready docs."
  path="/developers"
>
  {/* Hero */}
  <Section size="lg">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <Eyebrow>Developer platform</Eyebrow>
        <h1 class="mt-4 font-display text-display text-ink-900">
          Build the experience.{' '}
          <span class="text-purple-600">We run the medicine underneath.</span>
        </h1>
      </div>
      <div class="lg:col-span-5 lg:pt-3">
        <p class="text-body-lg text-ink-500">
          One contract-first API and signed webhooks for every step of the member journey. Bring any
          front end — our site kit, an AI-built storefront, or your own app — on a platform your
          team and your agents can drive end to end.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <Button variant="primary" href={DOCS_URL}>Read the docs</Button>
          <Button variant="secondary" type="button" id="run-journey">
            <Icon name="lucide:play" class="icon size-4 text-purple-600" />
            Run a journey
          </Button>
        </div>
      </div>
    </div>
    <div class="mx-auto -mb-6 mt-4 max-w-5xl md:-mb-14">
      <HeroArt />
    </div>
  </Section>

  {/* API */}
  <Section id="api" surface="surface" bordered>
    <div class="grid gap-10 lg:grid-cols-2 lg:items-start">
      <div>
        <SectionHeader
          eyebrow="The API"
          title="One API for the whole member journey."
          lead="Versioned under /v1, documented from the contracts the platform implements, and testable end to end."
        />
        <div class="mt-8">
          <Button variant="link-arrow" href={DOCS_URL}>Open the API reference</Button>
        </div>
      </div>
      <pre
        class="overflow-x-auto rounded-lg border border-line bg-surface-sunken p-6 font-mono text-sm text-ink-700"><code>{sample}</code></pre>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        surfaces.map((s) => (
          <Card icon={s.icon} title={s.title}>
            {s.body}
          </Card>
        ))
      }
    </div>
  </Section>

  {/* Guarantees */}
  <Section>
    <SectionHeader
      eyebrow="Built to build on"
      title="The guarantees that make health safe to automate."
      lead="Regulated money and medicine leave no room for “usually works”."
    />
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        guarantees.map((g) => (
          <Card icon={g.icon} title={g.title}>
            {g.body}
          </Card>
        ))
      }
    </div>
  </Section>

  {/* Webhooks */}
  <Section id="webhooks" surface="sunken" bordered>
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <SectionHeader
          eyebrow="Webhooks & events"
          title="Every step, as a signed event."
          lead="Subscribe to journey and onboarding events. Deliveries are HMAC-signed and carry references, never health data — read the details back with your key. Failed deliveries retry automatically, and you can test-fire any registration."
        />
      </div>
      <div class="lg:col-span-7">
        <ul class="grid gap-2 sm:grid-cols-2">
          {
            events.map((e) => (
              <li class="flex items-center gap-2 rounded-md border border-line bg-surface px-3 py-2 font-mono text-sm text-ink-700">
                <Icon name="lucide:webhook" class="icon size-4 shrink-0 text-purple-600" />
                {e}
              </li>
            ))
          }
        </ul>
        <p class="mt-3 text-sm text-ink-400">A selection — the full catalog lives in the docs.</p>
      </div>
    </div>
  </Section>

  {/* Front ends */}
  <Section id="front-ends">
    <SectionHeader
      eyebrow="Your front end"
      title="Three ways to put your brand on it."
      lead="Checkout and identity run on hardened, hosted steps; everything else is yours to design."
    />
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        frontEnds.map((f) => (
          <Card icon={f.icon} title={f.title}>
            {f.body}
          </Card>
        ))
      }
    </div>
  </Section>

  {/* Agents */}
  <Section id="agents" surface="surface" bordered>
    <SectionHeader
      eyebrow="Agents & MCP"
      title="A platform your AI agents can build on, too."
      lead="The same contracts that make the API predictable make it legible to agents."
    />
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        agents.map((a) => (
          <Card icon={a.icon} title={a.title}>
            {a.body}
          </Card>
        ))
      }
    </div>
  </Section>

  {/* CTA */}
  <Section>
    <SectionHeader
      align="center"
      eyebrow="Get started"
      title="Start in the test environment."
      lead="Keys are issued when you onboard. Build end to end against the test environment, then go live at launch."
    />
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <Button variant="primary" href={DOCS_URL}>Read the docs</Button>
      <Button variant="secondary" href={CTA.consult.href}>{CTA.consult.label}</Button>
    </div>
  </Section>
</PageLayout>
