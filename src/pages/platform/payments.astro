---
/**
 * Payments `/platform/payments` (sitemap.md §4, content.md). Telehealth merchant accounts,
 * subscriptions, refunds — on each client's own merchant. Back-references /architecture
 * (refunds = the saga's compensation path; client-side tokenization → SAQ-A). The PCI/SAQ-A claim is
 * counsel-gated via <Unconfirmed>. Processing rates live on /pricing.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/layout/Section.astro';
import SectionHeader from '../../components/primitives/SectionHeader.astro';
import Eyebrow from '../../components/primitives/Eyebrow.astro';
import Button from '../../components/primitives/Button.astro';
import Card from '../../components/primitives/Card.astro';
import Unconfirmed from '../../components/marketing/Unconfirmed.astro';

const features = [
  {
    icon: 'building-2',
    title: 'Your merchant, your margin',
    body: 'Payments run through your own merchant account — no platform middleman taking a cut of every charge.',
  },
  {
    icon: 'credit-card',
    title: 'Telehealth-ready merchant accounts',
    body: 'Payment setup built for virtual care, on each client’s own merchant account — your payments, your margin.',
  },
  {
    icon: 'repeat',
    title: 'Subscriptions & rebills',
    body: 'Recurring therapy billing with dunning and retries, so refills bill themselves and revenue doesn’t leak.',
  },
  {
    icon: 'rotate-ccw',
    title: 'Refunds & adjustments',
    body: 'Issue refunds programmatically — a refund and a cancelled order always stay in sync, so money and fulfillment match.',
  },
  {
    icon: 'shield-check',
    title: 'Card data never touches us',
    note: 'Client-side tokenization keeps cardholder data off our systems — SAQ-A scope, not full PCI-DSS.',
  },
  {
    icon: 'code',
    title: 'Callable by your agents',
    body: 'Create charges and subscriptions, issue refunds, and react to payment.captured events through the API.',
  },
];

const paymentSample = `POST /v1/subscriptions
{
  "patient_id": "pat_77a1...",
  "plan": "monthly-therapy",
  "payment_token": "tok_live_..."
}

201 Created
{ "subscription_id": "sub_9k4d...", "status": "active" }`;
---

<PageLayout
  title="Payments — your merchant account, your margin"
  description="Charge, subscribe, and refund on your own merchant account with no per-charge platform fee. Billing built for recurring therapy, refunds and cancellations always kept in sync, and client-side tokenization that keeps cardholder data off our systems — all callable by your agents and the API."
  path="/platform/payments"
>
  {/* Hero */}
  <Section size="lg">
    <Eyebrow>Payments</Eyebrow>
    <h1 class="mt-4 max-w-prose font-display text-display text-ink-900">
      Your merchant account, your margin.
    </h1>
    <p class="mt-6 max-w-prose text-body-lg text-ink-500">
      Charge, subscribe, and refund on your own merchant account — no per-charge platform fee
      skimmed off the top. Billing is built for recurring therapy, with refunds and order
      cancellations always kept in sync so money and fulfillment match. Cardholder data is tokenized
      client-side and never touches our systems.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <Button variant="primary" href="/contact">Book a consult</Button>
      <Button variant="link-arrow" href="/pricing">See pricing</Button>
    </div>
  </Section>

  {/* Features */}
  <Section surface="surface" bordered>
    <SectionHeader
      eyebrow="What's inside"
      title="Billing that keeps up with care."
      lead="Merchant accounts, subscriptions, refunds, and minimized PCI scope — exposed as API."
    />
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f) => (
          <Card icon={f.icon} title={f.title}>
            {f.body}
            {f.note && (
              <Unconfirmed reason="PCI scope (SAQ-A) & tokenization wording — confirm with counsel before launch">
                {f.note}
              </Unconfirmed>
            )}
          </Card>
        ))
      }
    </div>
  </Section>

  {/* Architecture back-reference */}
  <Section>
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <SectionHeader
          eyebrow="How it fits"
          title="Refunds and cancellations, always in sync."
          lead="Payments aren’t a bolt-on integration — charges and refunds are steps in the same durable order workflow. When an order can’t be fulfilled, the charge is automatically reversed in the same transaction, so money and fulfillment always match. A charge that’s retried bills once, never twice."
        />
        <div class="mt-6">
          <Button variant="link-arrow" href="/architecture">See the architecture</Button>
        </div>
      </div>
      <div>
        <pre
          class="overflow-x-auto rounded-lg border border-line bg-surface-sunken p-6 font-mono text-sm text-ink-700"><code>{paymentSample}</code></pre>
        <p class="mt-3 text-sm text-ink-400">
          Illustrative — the live API surface is published in the docs.
        </p>
      </div>
    </div>
  </Section>

  {/* Closing CTA */}
  <Section surface="surface" bordered>
    <SectionHeader
      align="center"
      eyebrow="Get started"
      title="Bill for care on infrastructure that can't double-charge."
    />
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <Button variant="primary" href="/contact">Book a consult</Button>
      <Button variant="secondary" href="/pricing">See pricing</Button>
    </div>
  </Section>
</PageLayout>
