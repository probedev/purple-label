---
/**
 * Intake `/platform/intake` — agent/API-first intake (sitemap.md §3, content.md §3).
 * No no-code/builder language (locked decision #1): intake is data + code your agents control,
 * with identity verification built in (platform fact).
 */
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/layout/Section.astro';
import SectionHeader from '../../components/primitives/SectionHeader.astro';
import Eyebrow from '../../components/primitives/Eyebrow.astro';
import Button from '../../components/primitives/Button.astro';
import Card from '../../components/primitives/Card.astro';

const features = [
  {
    icon: 'git-merge',
    title: 'Composable, condition-aware questionnaires',
    body: 'Branching logic is captured as data and assembled via API. Your agents adapt flows to each condition and capture exactly the clinical information your providers need.',
  },
  {
    icon: 'sparkles',
    title: 'An intake prompt library',
    body: 'Curated, customizable prompts to generate, localize, and refine questionnaires for your brand — a starting point your agents tailor, not a template you fight.',
  },
  {
    icon: 'stethoscope',
    title: 'Clinical-grade components',
    body: 'Questions and logic reviewed for the information providers actually need — the same components running at scale, not a blank canvas.',
  },
  {
    icon: 'badge-check',
    title: 'Identity verification & KYC built in',
    body: 'Identity verification and KYC are part of the onboarding flow from the first question — not a bolt-on you wire yourself.',
  },
  {
    icon: 'route',
    title: 'Eligibility & routing',
    body: 'Route patients to async or video visits, to your providers or ours, on your own logic — all programmable.',
  },
  {
    icon: 'history',
    title: 'Versioning & analytics via API',
    body: 'Every change is tracked and reversible; completion and clarity metrics are available as data and events. No locked dashboard required.',
  },
];

const intakeSample = `POST /v1/intake/flows
{
  "condition": "weight-management",
  "components": [
    "eligibility",
    "id-verification",
    "medical-history",
    "shipping"
  ],
  "route_to": "async-visit"
}

201 Created
{ "flow_id": "flw_8k2c...", "status": "live" }`;
---

<PageLayout
  title="Intake — patient intake assembled in code, run by your agents"
  description="Build condition-aware patient intake from tested, clinical-grade components and a customizable prompt library, with identity verification built in — assembled, launched, and iterated by your agents through the API."
  path="/platform/intake"
>
  {/* Hero */}
  <Section size="lg">
    <Eyebrow>Intake</Eyebrow>
    <h1 class="mt-4 max-w-prose font-display text-display text-ink-900">
      Patient intake, assembled in code and run by your agents.
    </h1>
    <p class="mt-6 max-w-prose text-body-lg text-ink-500">
      Build condition-aware intake from tested, clinical-grade components and a customizable prompt
      library — then let your agents assemble, launch, and iterate it through the API. There's no
      drag-and-drop builder to outgrow; intake is data and code your team and your agents control.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <Button variant="primary" href="/developers#api-reference">Read the intake docs</Button>
      <Button variant="link-arrow" href="/contact">Request a demo</Button>
    </div>
  </Section>

  {/* Features */}
  <Section surface="surface" bordered>
    <SectionHeader
      eyebrow="What's inside"
      title="Tested components and prompts — driven by your agents."
      lead="The pieces that already run intake at national scale, exposed as code instead of a builder."
    />
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f) => (
          <Card icon={f.icon} title={f.title}>
            {f.body}
          </Card>
        ))
      }
    </div>
  </Section>

  {/* Code sample */}
  <Section>
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <SectionHeader
          eyebrow="Assembled via API"
          title="Your agent builds the flow."
          lead="Compose an intake flow from components and let your agent launch it — no builder, no console."
        />
      </div>
      <div>
        <pre
          class="overflow-x-auto rounded-lg border border-line bg-surface-sunken p-6 font-mono text-sm text-ink-700"><code>{intakeSample}</code></pre>
        <p class="mt-3 text-sm text-ink-400">
          Illustrative — the live API surface is published in the docs.
        </p>
      </div>
    </div>
  </Section>

  {/* Closing CTA */}
  <Section surface="surface" bordered>
    <SectionHeader
      align="center"
      eyebrow="Get started"
      title="Stand up intake your agents control."
    />
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <Button variant="primary" href="/contact">Request a demo</Button>
      <Button variant="secondary" href="/developers">Read the docs</Button>
    </div>
  </Section>
</PageLayout>
