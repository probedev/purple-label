---
/**
 * Patient Management `/platform/patients` (sitemap.md §4, content.md). The longitudinal record as
 * the read side of the event backbone: one record across modules, secure messaging, care
 * coordination, audit-for-free. Back-references /architecture (event backbone → projection).
 */
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/layout/Section.astro';
import SectionHeader from '../../components/primitives/SectionHeader.astro';
import Eyebrow from '../../components/primitives/Eyebrow.astro';
import Button from '../../components/primitives/Button.astro';
import Card from '../../components/primitives/Card.astro';
import { DOCS_URL } from '../../lib/nav';

const features = [
  {
    icon: 'users-round',
    title: 'One longitudinal record',
    body: 'Every visit, prescription, order, and message attaches to a single patient record, shared across every module — an API and an event stream, not an EMR silo.',
  },
  {
    icon: 'messages-square',
    title: 'Secure messaging',
    body: 'HIPAA-compliant patient–provider messaging, available to your agents and your support team through the same API.',
  },
  {
    icon: 'list-checks',
    title: 'Care coordination',
    body: 'Tasks, follow-ups, and provider hand-offs tracked against the record so nothing falls between encounters.',
  },
  {
    icon: 'history',
    title: 'Full audit trail by design',
    body: 'Every change is logged automatically — no re-integrating data later — so the evidence your compliance reviews need is always on tap.',
  },
  {
    icon: 'shield-check',
    title: 'PHI-grade access control',
    body: 'Field-encrypted PHI with granular, role-scoped access — the same controls behind our cleared HIPAA audit.',
  },
  {
    icon: 'code',
    title: 'Callable by your agents',
    body: 'Read and update the record, send messages, and react to lifecycle events through the API — your agents drive coordination.',
  },
];

const patientSample = `GET /v1/patients/pat_77a1...

200 OK
{
  "patient_id": "pat_77a1...",
  "visits": 4,
  "active_subscriptions": 1,
  "last_event": "rx.prescribed"
}`;
---

<PageLayout
  title="Patient Management — see the whole patient, in one place"
  description="A single longitudinal patient record so your team always sees the whole patient — across intake, visits, prescribing, pharmacy, and payments — with secure messaging, care coordination, a built-in audit trail, and an API your agents can drive."
  path="/platform/patients"
>
  {/* Hero */}
  <Section size="lg">
    <Eyebrow>Patient Management</Eyebrow>
    <h1 class="mt-4 max-w-prose font-display text-display text-ink-900">
      See the whole patient, not a dozen disconnected systems.
    </h1>
    <p class="mt-6 max-w-prose text-body-lg text-ink-500">
      Intake, visits, prescriptions, orders, and messages all attach to a single longitudinal record
      — so your team always sees the whole patient, in one place, instead of stitching together a
      dozen systems that never agree.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <Button variant="primary" href="/contact">Book a consult</Button>
      <Button variant="link-arrow" href={DOCS_URL}>Read the docs</Button>
    </div>
  </Section>

  {/* Features */}
  <Section surface="surface" bordered>
    <SectionHeader
      eyebrow="What's inside"
      title="The whole patient, in one place."
      lead="Records, messaging, coordination, and audit — exposed as API instead of locked in an EMR."
    />
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f) => (
          <Card icon={f.icon} title={f.title}>
            {f.body}
          </Card>
        ))
      }
    </div>
  </Section>

  {/* Architecture back-reference */}
  <Section>
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <SectionHeader
          eyebrow="How it fits"
          title="The record is a projection of every event."
          lead="Under the hood, the record is the read side of the platform's event backbone: each module publishes domain events, and Patient Management projects every event into one view. Rebuildable by replay, logged by construction — that's how the audit trail comes for free. And it's callable from your stack."
        />
        <div class="mt-6">
          <Button variant="link-arrow" href="/architecture">See the architecture</Button>
        </div>
      </div>
      <div>
        <pre
          class="overflow-x-auto rounded-lg border border-line bg-surface-sunken p-6 font-mono text-sm text-ink-700"><code>{patientSample}</code></pre>
        <p class="mt-3 text-sm text-ink-400">
          Illustrative — the live reference lives at <a
            href={DOCS_URL}
            class="font-semibold text-purple-600 transition-colors duration-150 hover:text-purple-700"
            >docs.purplelabelmd.com</a
          >.
        </p>
      </div>
    </div>
  </Section>

  {/* Closing CTA */}
  <Section surface="surface" bordered>
    <SectionHeader
      align="center"
      eyebrow="Get started"
      title="Give every module one source of truth."
    />
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <Button variant="primary" href="/contact">Book a consult</Button>
      <Button variant="secondary" href={DOCS_URL}>Read the docs</Button>
    </div>
  </Section>
</PageLayout>
