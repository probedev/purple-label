---
/**
 * Platform `/platform` — the modular toolkit overview (sitemap.md §2, content.md §2).
 * Summarizes all seven modules with deep-links, plus the agent/Developers spine and the
 * inherit-our-scale section.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/layout/Section.astro';
import SectionHeader from '../../components/primitives/SectionHeader.astro';
import Eyebrow from '../../components/primitives/Eyebrow.astro';
import Button from '../../components/primitives/Button.astro';
import Card from '../../components/primitives/Card.astro';
import StatCard from '../../components/primitives/StatCard.astro';
import Heritage from '../../components/marketing/Heritage.astro';
import { STATS, PROOF_LINE } from '../../lib/stats';

/** StatCard props from a registry entry — no literal stats in this file (G1). */
const stat = (key: keyof typeof STATS) => ({
  value: STATS[key].value,
  label: STATS[key].label,
  caption: STATS[key].caption,
});

const modules = [
  {
    icon: 'clipboard-list',
    title: 'Intake',
    body: 'Agent- and API-first patient intake with identity verification built in. Assemble condition-aware questionnaires from tested components and prompts.',
    href: '/platform/intake',
  },
  {
    icon: 'stethoscope',
    title: 'Visits & E-Prescribing',
    body: 'Synchronous and async telemedicine visits with certified e-prescribing, routed by a real-time, multi-state provider engine.',
    href: '/platform/visits',
  },
  {
    icon: 'users',
    title: 'Patient Management',
    body: 'One longitudinal record, secure messaging, and care coordination — available as API and events.',
    href: '/platform/patients',
  },
  {
    icon: 'pill',
    title: 'Pharmacy & Fulfillment',
    body: 'A nationwide 503A/503B network with volume pricing passed straight through to you — zero markup — shipping to all 50 states.',
    href: '/platform/pharmacy-fulfillment',
  },
  {
    icon: 'credit-card',
    title: 'Payments',
    body: 'Telehealth merchant accounts, subscriptions, and refunds — callable from your stack.',
    href: '/platform/payments',
  },
  {
    icon: 'trending-up',
    title: 'Analytics & Growth',
    body: 'Cohorts, retention, order economics, conversion, and BI as data and endpoints — not locked dashboards.',
    href: '/platform/analytics',
  },
  {
    icon: 'shield-check',
    title: 'Security & Compliance',
    body: `A HIPAA-compliant data layer with end-to-end encryption and access governance under every module — with ${PROOF_LINE} behind it.`,
    href: '/security',
  },
];
---

<PageLayout
  title="Platform — run your whole telemedicine business from one platform"
  description="Run intake, visits, e-prescribing, patient management, pharmacy, payments, analytics, and security from one platform behind your brand — with one source of truth for patients, orders, and clinical data, modular by design and callable from your stack or your agents."
  path="/platform"
>
  {/* Hero */}
  <Section size="lg">
    <Eyebrow>The platform</Eyebrow>
    <h1 class="mt-4 max-w-prose font-display text-display text-ink-900">
      Run your whole telemedicine business from one platform.
    </h1>
    <p class="mt-6 max-w-prose text-body-lg text-ink-500">
      Intake, visits, e-prescribing, pharmacy, payments, and analytics — one platform behind your
      brand, with one source of truth for patients, orders, and clinical data. Modular by design, so
      you adopt the modules you need and call them from your stack, with one API for your agents.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <Button variant="primary" href="/contact">Book a consult</Button>
      <Button variant="link-arrow" href="/developers">Explore the developer surface</Button>
    </div>
  </Section>

  {/* Modular, not monolithic */}
  <Section surface="surface" bordered>
    <SectionHeader
      eyebrow="Modular, not monolithic"
      title="Every module is callable. Adopt one, or run the whole engine."
      lead="Start with Intake alone, or run intake → visit → e-prescribe → fulfill → deliver as one system. Shared identity, data, and compliance across all of it — no integration tax between your own modules."
    />
  </Section>

  {/* The modules */}
  <Section>
    <SectionHeader
      eyebrow="The modules"
      title="Best-of-breed, battle-tested at scale."
      lead="Each module is production infrastructure that already runs a national telehealth operation."
    />
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        modules.map((m) => (
          <Card icon={m.icon} title={m.title} href={m.href}>
            {m.body}
          </Card>
        ))
      }
    </div>
  </Section>

  {/* Build on it your way */}
  <Section surface="sunken" bordered>
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <SectionHeader
          eyebrow="Build on it your way"
          title="This is how you build on it."
          lead="Every module is exposed through one programmable surface: API tokens, agent-ready docs, and an agent pack — prompt playbooks now, MCP connectors at launch. Your team or your agents do the assembly; you keep full control."
        />
        <div class="mt-8">
          <Button variant="primary" href="/developers">Explore the developer surface</Button>
        </div>
      </div>
      <Card icon="code" title="One API for your agents">
        Point your team or your agents at the platform and let them stand up, operate, and extend
        each module — with a focused console where a human must act.
      </Card>
    </div>
  </Section>

  {
    /* Inherit our scale — the heritage×next-gen frame (G2); the old "3 years in
      production" platform-age claim now lives correctly inside the operators' story. */
  }
  <Section>
    <Heritage eyebrow="Inherit our scale" />
    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <StatCard {...stat('rxMonthly')} />
      <StatCard {...stat('ordersWeekly')} />
      <StatCard {...stat('brandsLaunched')} />
      <StatCard {...stat('providerNetwork')} />
    </div>
  </Section>

  {/* Closing CTA */}
  <Section surface="surface" bordered>
    <SectionHeader
      align="center"
      eyebrow="Get started"
      title="Build telemedicine your agents can run."
    />
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <Button variant="primary" href="/contact">Book a consult</Button>
      <Button variant="secondary" href="/developers">Explore the developer surface</Button>
    </div>
  </Section>
</PageLayout>
