---
/**
 * Security & Compliance `/security` — the trust page (sitemap.md §9, content.md §9).
 * Carries differentiator #1 for the non-technical compliance/legal buyer: human-legible,
 * not API-jargon. Attestations pulled from lib/nav TRUST_BADGES (HIPAA/LegitScript/Surescripts
 * confirmed; SOC 2 shown as in-progress).
 */
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/layout/Section.astro';
import SectionHeader from '../components/primitives/SectionHeader.astro';
import Eyebrow from '../components/primitives/Eyebrow.astro';
import Button from '../components/primitives/Button.astro';
import Card from '../components/primitives/Card.astro';
import StatCard from '../components/primitives/StatCard.astro';
import Badge from '../components/primitives/Badge.astro';
import FAQ from '../components/primitives/FAQ.astro';
import { TRUST_BADGES } from '../lib/nav';
import { faqJsonLd } from '../lib/seo';

const pillars = [
  {
    icon: 'lock',
    title: 'Encryption everywhere',
    body: 'A HIPAA-compliant data layer with end-to-end encryption — protected health information is encrypted in transit and at rest as a foundational control.',
  },
  {
    icon: 'key-round',
    title: 'Access control & MFA',
    body: 'Multi-factor authentication and granular, role-based access — every action happens in a controlled, least-privilege environment.',
  },
  {
    icon: 'shield-check',
    title: 'HIPAA & PHI handling',
    body: 'HIPAA-compliant infrastructure, with PHI handling and patient-rights controls built in. We sign Business Associate Agreements with every customer.',
  },
  {
    icon: 'refresh-cw',
    title: 'Continuous compliance',
    body: 'Controls are monitored and kept in force continuously — not just at audit time.',
  },
  {
    icon: 'fingerprint',
    title: 'Identity & device management',
    body: 'Identity verification and device controls govern who and what can reach the platform.',
  },
  {
    icon: 'database',
    title: 'Data ownership & governance',
    body: 'Clear data ownership and information governance — your data stays yours, with a documented chain of custody.',
  },
];

const legitWhy = [
  {
    icon: 'megaphone',
    title: 'Advertise on Google & Meta',
    body: 'The major ad networks require LegitScript certification to run healthcare and pharmacy ads. No certification, no paid traffic.',
  },
  {
    icon: 'credit-card',
    title: 'Get approved by processors',
    body: "Most payment processors won't onboard a healthcare merchant without it — certification keeps your revenue flowing.",
  },
  {
    icon: 'badge-check',
    title: 'Earn patient trust',
    body: 'The LegitScript seal signals to patients and partners that the brand operates legally, safely, and transparently.',
  },
  {
    icon: 'refresh-cw',
    title: 'Stay compliant as you scale',
    body: 'Ongoing monitoring keeps every brand certified as regulations, catalogs, and networks change over time.',
  },
];

const legitStack = [
  {
    icon: 'pill',
    title: 'Pharmacies',
    body: '503A and 503B pharmacies across the fulfillment network — certified and audit-ready.',
  },
  {
    icon: 'stethoscope',
    title: 'Providers',
    body: 'Licensed prescribers credentialed and certified to operate compliantly in every state.',
  },
  {
    icon: 'globe',
    title: 'Websites & brands',
    body: 'Each branded storefront certified so it can legally advertise from day one.',
  },
];

const legitSteps = [
  {
    step: '01',
    title: 'Assessment',
    body: "We review the brand, model, and catalog against LegitScript's standards and flag anything to fix.",
  },
  {
    step: '02',
    title: 'Documentation',
    body: 'We prepare and package the application, policies, and evidence LegitScript requires.',
  },
  {
    step: '03',
    title: 'Submission & review',
    body: 'We submit through the enterprise partnership and manage the review and any remediation.',
  },
  {
    step: '04',
    title: 'Certified & monitored',
    body: 'You go live certified — and stay compliant with ongoing monitoring.',
  },
];

const legitFaqs = [
  {
    q: 'What is LegitScript certification?',
    a: 'LegitScript certification verifies that healthcare and telehealth merchants operate legally and transparently. It is required to advertise on Google, Meta, and most major ad networks, and to work with most payment processors.',
  },
  {
    q: 'Do I need it to launch a telehealth brand?',
    a: "In practice, yes. Without LegitScript certification you can't run paid advertising on the major platforms or reliably process payments for a healthcare brand — so it is built in from day one.",
  },
  {
    q: 'How long does certification take?',
    a: 'On your own it can take months. As a LegitScript Enterprise Partner, your brand inherits pre-certified infrastructure and a fast-track process that significantly reduces the normal timeline.',
  },
  {
    q: 'What is handled for me?',
    a: 'Over 250 certifications have been completed across pharmacies, providers, and websites. The application, documentation, and any remediation are managed end to end so your brand launches on a compliant foundation.',
  },
  {
    q: 'Can you certify a brand I already run?',
    a: "Yes. Whether you're launching new or already operating, your pharmacy, providers, and website can be brought into compliance and certification.",
  },
  {
    q: 'Does it cover all 50 states?',
    a: 'The provider and pharmacy network is credentialed and certified for nationwide, 50-state operation.',
  },
  {
    q: "What happens after I'm certified?",
    a: 'Certification is not one-and-done. Ongoing monitoring keeps you compliant as regulations, your catalog, and your network evolve over time.',
  },
];
---

<PageLayout
  title="Security & Compliance — enterprise-grade protection for PHI"
  description="HIPAA-compliant infrastructure with end-to-end encryption, MFA, and access governance — behind cleared HIPAA, pharmacy-board, and payment-processor audits. LegitScript certified, Surescripts connected, SOC 2 in progress. We sign BAAs."
  path="/security"
  jsonLd={[faqJsonLd(legitFaqs)]}
>
  {/* Hero */}
  <Section size="lg">
    <Eyebrow>Security & Compliance</Eyebrow>
    <h1 class="mt-4 max-w-prose font-display text-display text-ink-900">
      Enterprise-grade protection for protected health information.
    </h1>
    <p class="mt-6 max-w-prose text-body-lg text-ink-500">
      Security governance, risk management, and continuous compliance are built into the platform —
      the same controls behind a national telehealth operation, on HIPAA-compliant infrastructure.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-3">
      {
        TRUST_BADGES.map((b) =>
          b.status === 'confirmed' ? (
            <Badge tone="success" icon="badge-check">
              {b.label}
            </Badge>
          ) : (
            <Badge tone="neutral">{b.label} — in progress</Badge>
          ),
        )
      }
    </div>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <Button variant="primary" href="/contact">Talk to sales</Button>
      <Button variant="link-arrow" href="/platform">See the platform</Button>
    </div>
  </Section>

  {/* Trust pillars */}
  <Section surface="surface" bordered>
    <SectionHeader
      eyebrow="The controls"
      title="Protection built in at every layer."
      lead="The controls your compliance, clinical, and legal teams will ask about — already in place."
    />
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        pillars.map((p) => (
          <Card icon={p.icon} title={p.title}>
            {p.body}
          </Card>
        ))
      }
    </div>
  </Section>

  {/* The audits */}
  <Section>
    <SectionHeader
      eyebrow="The proof"
      title="We've already passed the audits."
      lead="New partners launch on infrastructure that's already cleared the inspections most telehealth projects never survive."
    />
    <p class="mt-6 max-w-prose text-body-lg text-ink-500">
      Competitors spinning up no-code or AI-generated sites hit a wall the moment they try to ship a
      prescription across state lines, refund a patient, or pass a state pharmacy-board inspection.
      We've already paid those costs.
    </p>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      <Card icon="badge-check" title="HIPAA audit"> HIPAA-compliant infrastructure, cleared. </Card>
      <Card icon="badge-check" title="Pharmacy-board audit">
        State board of pharmacy licensure and inspection, cleared.
      </Card>
      <Card icon="badge-check" title="Payment-processor audit">
        Healthcare-commerce payment processing, cleared.
      </Card>
    </div>
  </Section>

  {/* LegitScript — the advertising / payments / trust gate */}
  <Section surface="sunken" bordered>
    <SectionHeader
      eyebrow="LegitScript"
      title="Certified to advertise, get paid, and be trusted."
      lead="Compliance isn't a checkbox — it's the gate to traffic, payments, and patient trust. As a LegitScript Enterprise Partner, we certify the entire stack so your brand inherits a compliant foundation from day one."
    />
    <div class="mt-12 grid gap-8 sm:grid-cols-3">
      <StatCard
        value="250+"
        label="Certifications completed"
        caption="Pharmacies, providers, sites"
      />
      <StatCard
        value="Enterprise"
        label="LegitScript partner tier"
        caption="Fast-tracked approval"
      />
      <StatCard value="50" label="States covered" caption="Nationwide operation" />
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        legitWhy.map((w) => (
          <Card icon={w.icon} title={w.title}>
            {w.body}
          </Card>
        ))
      }
    </div>
    <div class="mt-12">
      <SectionHeader
        eyebrow="The whole stack"
        title="Pharmacies, providers, and websites — all certified."
      />
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {
          legitStack.map((s) => (
            <Card icon={s.icon} title={s.title}>
              {s.body}
            </Card>
          ))
        }
      </div>
    </div>

    <div class="mt-12">
      <SectionHeader eyebrow="The process" title="How we get you certified." />
      <ol class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          legitSteps.map((s) => (
            <li class="rounded-lg border border-line bg-surface p-6">
              <span class="font-mono text-sm text-purple-500">{s.step}</span>
              <p class="mt-3 font-display text-h4 text-ink-900">{s.title}</p>
              <p class="mt-2 text-sm text-ink-500">{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </Section>

  {/* LegitScript FAQ */}
  <Section>
    <SectionHeader
      align="center"
      eyebrow="LegitScript questions"
      title="Certification, answered."
    />
    <FAQ class="mt-12" items={legitFaqs} />
  </Section>

  {/* Closing CTA */}
  <Section surface="surface" bordered>
    <SectionHeader
      align="center"
      eyebrow="Talk to us"
      title="Bring your compliance team. We'll bring the documentation."
    />
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <Button variant="primary" href="/contact">Talk to sales</Button>
      <Button variant="secondary" href="/platform">Explore the platform</Button>
    </div>
  </Section>
</PageLayout>
