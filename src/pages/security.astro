---
/**
 * Security & Compliance `/security` — the trust page (sitemap.md §9, content.md §9).
 * Carries differentiator #1 for the non-technical compliance/legal buyer: human-legible,
 * not API-jargon. Attestations pulled from lib/nav TRUST_BADGES (HIPAA/LegitScript confirmed;
 * SOC 2 shown as in-progress; Surescripts removed Nov 2026).
 *
 * Nov 2026 refresh: leads with "privacy by architecture" — the member-data story a consumer
 * health experience needs (per-member keys, provable erasure, PHI-free events, tenant
 * isolation, fail-closed audit), ahead of the original controls and review proof.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/layout/Section.astro';
import SectionHeader from '../components/primitives/SectionHeader.astro';
import Eyebrow from '../components/primitives/Eyebrow.astro';
import Button from '../components/primitives/Button.astro';
import Card from '../components/primitives/Card.astro';
import StatCard from '../components/primitives/StatCard.astro';
import Badge from '../components/primitives/Badge.astro';
import { TRUST_BADGES, CTA } from '../lib/nav';
import { STATS, PROOF_LINE } from '../lib/stats';

// E26: each pillar carries one architecture-backed specific — /security and
// /architecture should read as one story at two altitudes.
const architecture = [
  {
    icon: 'key-round',
    title: 'A key for every member',
    body: 'Each member’s health data is encrypted with its own key. When a member asks to be forgotten, the key is destroyed — and the data is unrecoverable, provably.',
  },
  {
    icon: 'eye-off',
    title: 'Health data stays in the record',
    body: 'Events, webhooks, and status reads carry references, not health data — so PHI never sprays across your tools, logs, or vendors.',
  },
  {
    icon: 'building',
    title: 'Isolation you can test',
    body: 'Every brand is isolated by design, with tenancy derived from credentials. Another tenant’s data answers exactly like data that doesn’t exist.',
  },
  {
    icon: 'scroll-text',
    title: 'Audit that fails closed',
    body: 'Every sensitive read is audited in the same transaction — if the audit record can’t be written, the read doesn’t happen.',
  },
  {
    icon: 'users-round',
    title: 'Operations without PHI',
    body: 'Your team follows and resolves every order without opening a member’s health answers. Clinical data stays with clinicians.',
  },
  {
    icon: 'ban',
    title: 'Never sold',
    body: 'Member data belongs to your brand and your members. We don’t sell it — identified or de-identified.',
  },
];

const pillars = [
  {
    icon: 'lock',
    title: 'Encryption everywhere',
    body: 'A HIPAA-compliant data layer with end-to-end encryption — protected health information is encrypted in transit and at rest, with field-level encryption on the most sensitive values.',
  },
  {
    icon: 'key-round',
    title: 'Access control & MFA',
    body: 'Multi-factor authentication and granular, role-based access — every action happens in a controlled, least-privilege environment, with tenant isolation enforced as row-level security in the database itself.',
  },
  {
    icon: 'shield-check',
    title: 'HIPAA & PHI handling',
    body: 'HIPAA-compliant infrastructure, with PHI handling and patient-rights controls built in. We sign Business Associate Agreements with every customer.',
  },
  {
    icon: 'refresh-cw',
    title: 'Continuous compliance',
    body: 'Controls are monitored and kept in force continuously — and the append-only audit log makes compliance evidence a property of the system, not a binder assembled at audit time.',
  },
  {
    icon: 'fingerprint',
    title: 'Identity & device management',
    body: 'Identity verification and device controls govern who and what can reach the platform — including per-agent machine identities, so your AI agents act under credentials of their own.',
  },
  {
    icon: 'database',
    title: 'Data ownership & governance',
    body: 'Clear data ownership and information governance — your data stays yours, with a documented chain of custody.',
  },
];
---

<PageLayout
  title="Privacy & Security — health data protected by architecture"
  description="Per-member encryption with provable erasure, PHI-free events, tenant isolation, and audit that fails closed — on HIPAA-compliant infrastructure behind cleared reviews. LegitScript Enterprise Partner; SOC 2 in progress."
  path="/security"
>
  {/* Hero */}
  <Section size="lg">
    <Eyebrow>Privacy & Security</Eyebrow>
    <h1 class="mt-4 max-w-prose font-display text-display text-ink-900">
      Your members’ health data, protected by how the platform is built.
    </h1>
    <p class="mt-6 max-w-prose text-body-lg text-ink-500">
      A consumer health experience collects the most sensitive data people have — labs, devices,
      prescriptions, history. Purple Label protects it in the architecture itself, on
      HIPAA-compliant infrastructure with the governance your compliance team expects.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-3">
      {
        TRUST_BADGES.map((b) =>
          b.status === 'confirmed' ? (
            <Badge tone="success" icon="badge-check">
              {b.label}
            </Badge>
          ) : (
            <Badge tone="neutral">{b.label} — in progress</Badge>
          ),
        )
      }
    </div>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <Button variant="primary" href={CTA.consult.href}>{CTA.consult.label}</Button>
      <Button variant="link-arrow" href="/platform">See the platform</Button>
    </div>
  </Section>

  {/* Privacy by architecture */}
  <Section surface="surface" bordered>
    <SectionHeader
      eyebrow="Privacy by architecture"
      title="Not a policy layered on top. A property of the system."
      lead="The guarantees members and regulators care about are enforced by design — not by everyone remembering the rules."
    />
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        architecture.map((p) => (
          <Card icon={p.icon} title={p.title}>
            {p.body}
          </Card>
        ))
      }
    </div>
  </Section>

  {/* Trust pillars */}
  <Section bordered>
    <SectionHeader
      eyebrow="The controls"
      title="Protection built in at every layer."
      lead="The controls your compliance, clinical, and legal teams will ask about — already in place."
    />
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        pillars.map((p) => (
          <Card icon={p.icon} title={p.title}>
            {p.body}
          </Card>
        ))
      }
    </div>
  </Section>

  {
    /* The reviews — E27: the standardized proof line, plus the actual next step a
      compliance buyer wants. */
  }
  <Section>
    <SectionHeader
      eyebrow="The proof"
      title="We've already passed the reviews."
      lead={`New partners launch on infrastructure that has already ${PROOF_LINE} — the inspections most telehealth projects never survive.`}
    />
    <p class="mt-6 max-w-prose text-body-lg text-ink-500">
      Competitors spinning up no-code or AI-generated sites hit a wall the moment they try to ship a
      prescription across state lines, refund a patient, or pass a state pharmacy-board inspection.
      We've already paid those costs.
    </p>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      <Card icon="badge-check" title="HIPAA review">
        HIPAA-compliant infrastructure, cleared.
      </Card>
      <Card icon="badge-check" title="State pharmacy-board review">
        State board of pharmacy licensure and inspection, cleared.
      </Card>
      <Card icon="badge-check" title="Payment-processor review">
        Healthcare-commerce payment processing, cleared.
      </Card>
    </div>
    <p class="mt-8 max-w-prose text-body text-ink-500">
      Documentation is available under NDA on your consult — bring your compliance team. For the
      engineering-level story behind these controls, see{' '}
      <a
        href="/architecture"
        class="font-semibold text-purple-600 transition-colors duration-150 hover:text-purple-700"
        >the architecture</a
      >.
    </p>
  </Section>

  {/* LegitScript teaser — the deep page lives at /legitscript; the anchor stays for old links */}
  <Section id="legitscript" surface="sunken" bordered>
    <SectionHeader
      eyebrow="LegitScript"
      title="Certified to advertise, get paid, and be trusted."
      lead="Compliance isn't a checkbox — it's the gate to traffic, payments, and patient trust. As a LegitScript Enterprise Partner, we certify the entire stack so your brand inherits a compliant foundation from day one."
    />
    <div class="mt-12 grid gap-8 sm:grid-cols-3">
      <StatCard
        value={STATS.legitscriptCerts.value}
        label="Certifications completed"
        caption="Pharmacies, providers, sites"
      />
      <StatCard
        value={STATS.legitscriptTier.value}
        label={STATS.legitscriptTier.label}
        caption={STATS.legitscriptTier.caption}
      />
      <StatCard
        value={STATS.statesCovered.value}
        label={STATS.statesCovered.label}
        caption={STATS.statesCovered.caption}
      />
    </div>
    <div class="mt-8">
      <Button variant="link-arrow" href="/legitscript">
        The full LegitScript story — why it matters, what we certify, and how
      </Button>
    </div>
  </Section>

  {/* Closing CTA */}
  <Section surface="surface" bordered>
    <SectionHeader
      align="center"
      eyebrow="Talk to us"
      title="Bring your compliance team. We'll bring the documentation."
    />
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <Button variant="primary" href={CTA.consult.href}>{CTA.consult.label}</Button>
      <Button variant="secondary" href="/platform">Explore the platform</Button>
    </div>
  </Section>
</PageLayout>
