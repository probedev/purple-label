---
/**
 * Programs `/programs` — the condition verticals the platform supports, framed infra-first
 * (folded from the legacy White Label MD program menu; see [[purplelabel-wlmd-relationship]]).
 * These are real programs already running on the engine at scale. Voice rule: agents assemble
 * them from the same modules — NOT a done-for-you agency menu. Flagship = weight loss / GLP-1.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/layout/Section.astro';
import SectionHeader from '../components/primitives/SectionHeader.astro';
import Eyebrow from '../components/primitives/Eyebrow.astro';
import Button from '../components/primitives/Button.astro';
import Card from '../components/primitives/Card.astro';
import Badge from '../components/primitives/Badge.astro';
import { PROGRAMS_DATA } from '../lib/programs';

const economics = [
  'Recurring, subscription-based revenue with high retention',
  'Pass-through pricing on medication and fulfillment — zero markup',
  'Strong margins that stay with you, not us',
  'Every program rides the same audited, compliant foundation',
];
---

<PageLayout
  title="Rx catalog — pass-through medication pricing, zero markup"
  description="A full medication catalog at pass-through cost, zero markup — GLP-1 weight loss, men's and women's health, TRT, HRT, ED, hair & skin, peptides, and integrated labs. Complete branded care programs your agents assemble, or our team runs, on a nationwide 503A/503B pharmacy network."
  path="/programs"
>
  {/* Hero */}
  <Section size="lg">
    <Eyebrow>Rx</Eyebrow>
    <h1 class="mt-4 max-w-prose font-display text-display text-ink-900">
      The full Rx catalog — at the
      <span class="text-purple-600">pass-through cost</span>, under your brand.
    </h1>
    <p class="mt-6 max-w-prose text-body-lg text-ink-500">
      Every program runs on the same nationwide 503A/503B pharmacy network, with medication passed
      straight through — zero markup, our cost is your cost. Launch one therapeutic area or the full
      menu: build it with your agents, or have our team run it.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <Button variant="primary" href="/contact">Book a consult</Button>
      <Button variant="link-arrow" href="/developers">Start building</Button>
    </div>
  </Section>

  {/* The catalog */}
  <Section surface="surface" bordered>
    <SectionHeader
      eyebrow="The catalog"
      title="Every program, already running on the platform."
      lead="Each one is the same modular stack, shaped to a therapeutic area and your brand."
    />
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        PROGRAMS_DATA.map((p) => (
          <Card icon={p.icon} title={p.title} href={`/programs/${p.slug}`}>
            {p.flagship && (
              <span class="mb-2 inline-block">
                <Badge tone="purple">Flagship</Badge>
              </span>
            )}
            {p.cardBody}
          </Card>
        ))
      }
    </div>
    <p class="mt-8 max-w-prose text-body text-ink-500">
      Don't see your category? Anything legal and compliant — your agents can compose a new program
      from the same modules, with custom formulations through our compounding partners.
    </p>
    {
      /* Counsel pass before launch: controlled-substance (TRT/Schedule III) & peptide/compounding wording. */
    }
    <p class="mt-4 max-w-prose text-sm text-ink-400">
      Program availability and prescribing follow clinical eligibility and applicable state and
      federal rules — including controlled-substance and compounding regulations. Compounded
      medications are not FDA-approved; availability follows FDA, state, and clinical rules.
    </p>
  </Section>

  {/* Flagship spotlight */}
  <Section>
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <SectionHeader
          eyebrow="Flagship · Weight loss"
          title="The biggest opportunity in consumer health."
          lead="GLP-1 and metabolic care is the fastest-growing category in telehealth — a recurring, subscription program with refills, strong margins, and high retention. With pass-through pricing on medication and fulfillment, that margin stays yours."
        />
        <ul class="mt-6 flex flex-col gap-3">
          {
            economics.map((e) => (
              <li class="flex gap-3 text-body text-ink-700">
                <span class="mt-1 size-2 shrink-0 rounded-full bg-purple-500" aria-hidden="true" />
                <span>{e}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <Button variant="primary" href="/contact">Book a consult</Button>
          <Button variant="link-arrow" href="/programs/weight-loss">See the full program</Button>
          <Button variant="link-arrow" href="/glp-1-weight-loss">The GLP-1 launch guide</Button>
        </div>
      </div>
      <div class="rounded-lg border border-line bg-surface-sunken p-8">
        <p class="font-display text-h4 text-ink-900">The journey, end to end.</p>
        <ol class="mt-6 flex flex-col gap-4">
          <li class="flex gap-4">
            <span class="font-mono text-sm text-purple-500">01</span>
            <span class="text-body text-ink-700">Branded intake and eligibility check.</span>
          </li>
          <li class="flex gap-4">
            <span class="font-mono text-sm text-purple-500">02</span>
            <span class="text-body text-ink-700">A licensed provider reviews — async or sync.</span>
          </li>
          <li class="flex gap-4">
            <span class="font-mono text-sm text-purple-500">03</span>
            <span class="text-body text-ink-700">Prescription, where clinically appropriate.</span>
          </li>
          <li class="flex gap-4">
            <span class="font-mono text-sm text-purple-500">04</span>
            <span class="text-body text-ink-700">Medication ships discreetly to the patient.</span>
          </li>
          <li class="flex gap-4">
            <span class="font-mono text-sm text-purple-500">05</span>
            <span class="text-body text-ink-700">Check-ins, titration, and automatic refills.</span>
          </li>
        </ol>
      </div>
    </div>
  </Section>

  {/* How programs are built */}
  <Section surface="sunken" bordered>
    <SectionHeader
      eyebrow="How it works"
      title="One pipeline underneath every program."
      lead="Every vertical runs on the same modules and the same cleared audits — so adding a program is composition, not a new build."
    />
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      <Card icon="boxes" title="Composed from modules" href="/platform">
        Intake, visits, e-prescribing, pharmacy, payments, and analytics — the building blocks of
        every program, callable from your stack.
      </Card>
      <Card icon="git-merge" title="The durable order pipeline" href="/architecture">
        A regulated, multi-party flow collapsed into one durable function — engineered so it won't
        double-charge, double-prescribe, or strand a patient mid-flow.
      </Card>
      <Card icon="shield-check" title="Compliant from the first patient" href="/security">
        LegitScript-certified infrastructure, licensed providers, and 50-state coverage — so you can
        advertise and scale with confidence.
      </Card>
    </div>
  </Section>

  {/* Closing CTA */}
  <Section surface="surface" bordered>
    <SectionHeader
      align="center"
      eyebrow="Get started"
      title="Launch your first program — or your full menu."
    />
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <Button variant="primary" href="/contact">Book a consult</Button>
      <Button variant="secondary" href="/developers">Start building</Button>
    </div>
  </Section>
</PageLayout>
