---
/**
 * Program deep page `/programs/[slug]` — one page per care vertical, generated from
 * src/lib/programs.ts. Folded from the legacy White Label MD per-program pages, revoiced
 * to Purple Label positioning: agents assemble the vertical from the same modules; you own
 * the brand, patients, and data; licensed providers handle clinical care. Each page emits
 * FAQPage + BreadcrumbList structured data.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/layout/Section.astro';
import SectionHeader from '../../components/primitives/SectionHeader.astro';
import Eyebrow from '../../components/primitives/Eyebrow.astro';
import Button from '../../components/primitives/Button.astro';
import Card from '../../components/primitives/Card.astro';
import Badge from '../../components/primitives/Badge.astro';
import FAQ from '../../components/primitives/FAQ.astro';
import { Icon } from 'astro-icon/components';
import { PROGRAMS_DATA, PROGRAM_TRUST, type Program } from '../../lib/programs';
import { faqJsonLd, breadcrumbJsonLd } from '../../lib/seo';

export function getStaticPaths() {
  return PROGRAMS_DATA.map((program) => ({
    params: { slug: program.slug },
    props: { program },
  }));
}

interface Props {
  program: Program;
}
const { program } = Astro.props;
const path = `/programs/${program.slug}`;
---

<PageLayout
  title={`${program.title} — a branded telehealth program your agents run`}
  description={program.intro}
  path={path}
  jsonLd={[
    faqJsonLd(program.faqs),
    breadcrumbJsonLd([
      ['Programs', '/programs'],
      [program.title, path],
    ]),
  ]}
>
  {/* Hero */}
  <Section size="lg">
    <Eyebrow>{program.eyebrow}</Eyebrow>
    <h1 class="mt-4 max-w-prose font-display text-display text-ink-900">{program.headline}</h1>
    <p class="mt-6 max-w-prose text-body-lg text-ink-500">{program.intro}</p>
    <ul class="mt-8 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-ink-400">
      {
        PROGRAM_TRUST.map((t) => (
          <li class="inline-flex items-center gap-1.5">
            <Icon name="lucide:check" class="icon size-4 text-success" />
            {t}
          </li>
        ))
      }
    </ul>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <Button variant="primary" href="/developers">Start building</Button>
      <Button variant="link-arrow" href="/contact">Talk to sales</Button>
    </div>
  </Section>

  {/* What you can offer */}
  <Section surface="surface" bordered>
    <div class="grid gap-10 lg:grid-cols-2 lg:items-start">
      <SectionHeader
        eyebrow="What you can offer"
        title="Launch one offering, or a full menu."
        lead="Every treatment runs on the same modular, compliant infrastructure — your agents compose the catalog and operate it under your brand."
      />
      <ul class="flex flex-col gap-3">
        {
          program.offerings.map((o) => (
            <li class="flex gap-3 text-body text-ink-700">
              <span class="mt-1 size-2 shrink-0 rounded-full bg-purple-500" aria-hidden="true" />
              <span>{o}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <p class="mt-8 max-w-prose text-sm text-ink-400">
      Program availability and prescribing follow clinical eligibility and applicable state and
      federal rules — including controlled-substance and compounding regulations.
    </p>
  </Section>

  {/* Patient journey (flagship only) */}
  {
    program.journey && (
      <Section>
        <SectionHeader
          eyebrow="The patient journey"
          title="Every step runs under your brand."
          lead="One durable pipeline carries the patient from intake to refills — on infrastructure that already runs at national scale."
        />
        <ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
          {program.journey.map((s) => (
            <li class="rounded-lg border border-line bg-surface p-6">
              <span class="font-mono text-sm text-purple-500">{s.step}</span>
              <p class="mt-3 font-display text-h4 text-ink-900">{s.title}</p>
              <p class="mt-2 text-sm text-ink-500">{s.body}</p>
            </li>
          ))}
        </ol>
      </Section>
    )
  }

  {/* How it's built */}
  <Section surface="sunken" bordered>
    <SectionHeader
      eyebrow="How it works"
      title="One pipeline underneath the program."
      lead="The same modules and the same cleared audits power every vertical — so adding this program is composition, not a new build."
    />
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      <Card icon="boxes" title="Composed from modules" href="/platform">
        Intake, visits, e-prescribing, pharmacy, payments, and analytics — callable from your stack.
      </Card>
      <Card icon="git-merge" title="The durable order pipeline" href="/architecture">
        A regulated, multi-party flow collapsed into one durable function that can't double-charge,
        double-prescribe, or strand a patient mid-flow.
      </Card>
      <Card icon="shield-check" title="Compliant from the first patient" href="/security">
        LegitScript-certified infrastructure, licensed providers, and 50-state coverage — advertise
        and scale with confidence.
      </Card>
    </div>
  </Section>

  {/* FAQ */}
  <Section>
    <SectionHeader
      align="center"
      eyebrow="Questions, answered"
      title={`${program.title}, in brief.`}
    />
    <FAQ class="mt-12" items={program.faqs} />
  </Section>

  {/* Closing CTA */}
  <Section surface="surface" bordered>
    <SectionHeader
      align="center"
      eyebrow="Get started"
      title="Stand up this program — or your full menu."
    />
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <Button variant="primary" href="/developers">Start building</Button>
      <Button variant="secondary" href="/contact">Talk to sales</Button>
    </div>
  </Section>
</PageLayout>
