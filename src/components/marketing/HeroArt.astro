---
/**
 * HeroArt — the patient saga as a scroll-driven descent (per Gregg 2026-07-24: "the
 * animation starting higher up and drawing the user down to complete the journey").
 *
 * The `POST /v1/orders` chip sits at the top right — directly under the hero CTAs —
 * and the pipeline descends in a tall serpentine. The comet's progress is scrubbed to
 * scroll (GSAP ScrollTrigger), so the reader completes the journey by scrolling: nodes
 * pop and their canonical platform events accumulate on the way down, the refill loop
 * arcs back up with `order.titrated`, and a `status: REFILL_DUE` chip bookends the
 * POST at the end. Scrolling back up reverses it. The old ECG jag lives on inside the
 * pipe between visit and rx.
 *
 * Node timings are not hand-tuned: the script samples the path to find each node's
 * fraction of the total length, so geometry edits can't desync the pops. All colors
 * trace to design tokens (re-themes with light/dark). prefers-reduced-motion renders
 * the completed journey as a still diagram.
 */

// Journey nodes ON the pipeline path below — cx/cy must sit on the path's segments.
const NODES = [
  { id: 'qualify', label: '01 qualify', cx: 420, cy: 120 },
  { id: 'pay', label: '02 pay', cx: 280, cy: 120 },
  { id: 'verify', label: '03 verify id', cx: 140, cy: 120 },
  { id: 'visit', label: '04 visit', cx: 160, cy: 290 },
  { id: 'rx', label: '05 rx', cx: 320, cy: 290 },
  { id: 'deliver', label: '06 deliver', cx: 440, cy: 290 },
  { id: 'follow', label: '07 follow-up', cx: 300, cy: 460 },
];

// Event chips that light up as the comet passes — the platform's canonical event names.
// They stay lit once fired, so the journey accumulates an event log as you descend.
const EVENTS = [
  { node: 'qualify', text: 'patient.qualified', x: 420, y: 96 },
  { node: 'pay', text: 'payment.captured', x: 280, y: 96 },
  { node: 'visit', text: 'visit.completed', x: 160, y: 266 },
  { node: 'rx', text: 'rx.prescribed', x: 320, y: 264 },
  { node: 'deliver', text: 'shipment.updated', x: 440, y: 264 },
];

// Tall serpentine, top-right to bottom: down from the POST chip, row 1 right-to-left,
// down the left edge, row 2 left-to-right (with the ECG jag), down the right edge,
// row 3 back to the follow-up. pathLength=1000 normalizes dash math.
const PIPE =
  'M500,44 V90 Q500,120 470,120 H110 Q80,120 80,150 V260 Q80,290 110,290 H198 l10,-24 l10,40 l8,-16 H470 Q500,290 500,320 V430 Q500,460 470,460 H260';

// The refill loop: follow-up arcs back up the left side to the visit node.
const LOOP = 'M300,460 Q40,430 152,302';
---

<div class="hero-art" aria-hidden="true">
  <svg class="ha-flow" viewBox="0 0 640 535" fill="none" preserveAspectRatio="xMidYMid meet">
    <g class="ha-cycle">
      {/* the pipe: faint track, scroll-drawn trail, and the traveling comet */}
      <path class="ha-track" d={PIPE} pathLength="1000"></path>
      <path class="ha-trail" d={PIPE} pathLength="1000"></path>
      <path class="ha-comet" d={PIPE} pathLength="1000"></path>

      {/* the refill loop back to the visit */}
      <path class="ha-loop-path" d={LOOP}></path>
      <circle class="ha-loop-dot" r="4"></circle>
      <text class="ha-mono ha-event ha-event-loop" x="120" y="400" text-anchor="middle"
        >order.titrated</text
      >

      {/* the API call that starts it all — up top, under the hero CTAs */}
      <g class="ha-post">
        <rect x="430" y="8" width="152" height="26" rx="7"></rect>
        <text class="ha-mono ha-post-text" x="440" y="25">POST /v1/orders</text>
      </g>

      {/* the journey's answer — the status read, at the bottom */}
      <g class="ha-status">
        <rect x="330" y="488" width="172" height="26" rx="7"></rect>
        <text class="ha-mono ha-status-text" x="340" y="505">status: REFILL_DUE</text>
      </g>

      {/* journey nodes + their always-on step labels */}
      {
        NODES.map((n) => (
          <g>
            <circle class={`ha-node ha-node-${n.id}`} cx={n.cx} cy={n.cy} r="5" />
            <text class="ha-mono ha-step" x={n.cx} y={n.cy + 24} text-anchor="middle">
              {n.label}
            </text>
          </g>
        ))
      }

      {/* event chips that accumulate as the comet passes */}
      {
        EVENTS.map((e) => (
          <text class={`ha-mono ha-event ha-event-${e.node}`} x={e.x} y={e.y} text-anchor="middle">
            {e.text}
          </text>
        ))
      }
    </g>
  </svg>
</div>

<style>
  /* A centered block that sizes to its container's width at the diagram's own 640:535
     aspect ratio — a tall-but-dense descent, not a background. */
  .hero-art {
    position: relative;
    width: 100%;
    pointer-events: none;
  }

  .ha-flow {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* ---- pipeline --------------------------------------------------------- */
  .ha-track,
  .ha-trail,
  .ha-comet,
  .ha-loop-path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .ha-track {
    stroke: var(--pl-purple-400);
    stroke-width: 2;
    opacity: 0.16;
  }
  .ha-trail {
    stroke: var(--pl-purple-500);
    stroke-width: 2;
    opacity: 0.55;
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000; /* drawn by scroll */
    will-change: stroke-dashoffset;
  }
  .ha-comet {
    stroke: var(--pl-teal-500);
    stroke-width: 3;
    opacity: 0.9;
    stroke-dasharray: 30 970; /* a 30/1000 lit window — the traveling front */
    stroke-dashoffset: 0;
    will-change: stroke-dashoffset;
  }
  .ha-loop-path {
    stroke: var(--pl-teal-500);
    stroke-width: 1.5;
    stroke-dasharray: 5 7;
    opacity: 0; /* fades in when the refill loop runs */
  }
  .ha-loop-dot {
    fill: var(--pl-teal-500);
    opacity: 0;
  }

  /* ---- nodes & type ------------------------------------------------------ */
  .ha-node {
    fill: var(--pl-paper);
    stroke: var(--pl-purple-400);
    stroke-width: 2;
    opacity: 0.9;
    transform-box: fill-box;
    transform-origin: center;
  }
  .ha-mono {
    font-family: var(--font-mono);
  }
  .ha-step {
    font-size: 12px;
    fill: var(--pl-ink-400);
    opacity: 0.75;
  }
  .ha-event {
    font-size: 12px;
    font-weight: 600;
    fill: var(--pl-teal-600);
    opacity: 0; /* lit as the comet passes; stays lit */
  }
  .ha-post rect,
  .ha-status rect {
    fill: var(--pl-surface);
    stroke: var(--pl-line);
    stroke-width: 1;
  }
  .ha-post-text {
    font-size: 13px;
    font-weight: 600;
    fill: var(--pl-purple-600);
  }
  .ha-status-text {
    font-size: 13px;
    font-weight: 600;
    fill: var(--pl-teal-600);
  }
  .ha-post {
    opacity: 0; /* fades in at the very start of the scrub */
  }
  .ha-status {
    opacity: 0; /* the journey's final beat */
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const motionOk = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const art = document.querySelector('.hero-art');

  // Same ids/coords as NODES in the template (duplicated — template values don't reach
  // the client script). Times are NOT hand-tuned: each node's moment is found by
  // sampling the path for the closest point.
  const NODE_COORDS: Array<[string, number, number]> = [
    ['qualify', 420, 120],
    ['pay', 280, 120],
    ['verify', 140, 120],
    ['visit', 160, 290],
    ['rx', 320, 290],
    ['deliver', 440, 290],
    ['follow', 300, 460],
  ];
  const EVENT_NODES = ['qualify', 'pay', 'visit', 'rx', 'deliver'];

  const DRAW_AT = 0.3; // timeline units (scrubbed, so these are proportions of scroll)
  const DRAW_DUR = 10;
  const LOOP_AT = DRAW_AT + DRAW_DUR + 0.2;

  if (art) {
    const q = (sel: string) => art.querySelector(sel);
    const nodeEl = (id: string) => q(`.ha-node-${id}`);
    const trail = q('.ha-trail') as SVGPathElement | null;

    /** Fraction (0–1) of the pipe's length nearest to a point — no hand-tuned timings. */
    const fracAt = (cx: number, cy: number): number => {
      if (!trail) return 0;
      const total = trail.getTotalLength();
      const SAMPLES = 600;
      let best = 0;
      let bestDist = Infinity;
      for (let i = 0; i <= SAMPLES; i++) {
        const pt = trail.getPointAtLength((total * i) / SAMPLES);
        const d = (pt.x - cx) ** 2 + (pt.y - cy) ** 2;
        if (d < bestDist) {
          bestDist = d;
          best = i / SAMPLES;
        }
      }
      return best;
    };

    if (motionOk && trail) {
      gsap.registerPlugin(ScrollTrigger);
      const tl = gsap.timeline({ paused: true });

      // 1) The API call lands as the diagram enters the viewport.
      tl.fromTo('.ha-post', { opacity: 0, y: 6 }, { opacity: 0.9, y: 0, duration: 0.4 }, 0);

      // 2) The pipe draws with the scroll; the comet rides its front.
      tl.fromTo(
        '.ha-trail',
        { strokeDashoffset: 1000 },
        { strokeDashoffset: 0, duration: DRAW_DUR, ease: 'none' },
        DRAW_AT,
      ).fromTo(
        '.ha-comet',
        { strokeDashoffset: 0, opacity: 0.9 },
        { strokeDashoffset: -970, duration: DRAW_DUR, ease: 'none' },
        DRAW_AT,
      );
      tl.to('.ha-comet', { opacity: 0, duration: 0.3 }, DRAW_AT + DRAW_DUR);

      // 3) Nodes pop as the front arrives; events light and STAY lit — the journey
      //    accumulates its event log as the reader descends. Fills switch via set()
      //    (GSAP can't interpolate var() colors); set() reverses cleanly under scrub.
      NODE_COORDS.forEach(([id, cx, cy]) => {
        const el = nodeEl(id);
        if (!el) return;
        const at = DRAW_AT + fracAt(cx, cy) * DRAW_DUR;
        tl.set(el, { fill: 'var(--pl-purple-500)', stroke: 'var(--pl-purple-500)' }, at);
        tl.fromTo(
          el,
          { scale: 1 },
          {
            keyframes: [
              { scale: 1.6, duration: 0.15, ease: 'power2.out' },
              { scale: 1, duration: 0.25, ease: 'power2.in' },
            ],
            transformOrigin: 'center',
            duration: 0.4,
          },
          at,
        );
        if (EVENT_NODES.includes(id)) {
          tl.fromTo(
            `.ha-event-${id}`,
            { opacity: 0, y: 8 },
            { opacity: 0.95, y: 0, duration: 0.35 },
            at + 0.05,
          );
        }
      });

      // 4) The refill loop: the dashed arc appears, a dot rides it back up to the
      //    visit node, order.titrated lights — care is a cycle.
      const arc = q('.ha-loop-path') as SVGPathElement | null;
      const dot = q('.ha-loop-dot');
      if (arc && dot) {
        const len = arc.getTotalLength();
        const prog = { p: 0 };
        tl.fromTo('.ha-loop-path', { opacity: 0 }, { opacity: 0.55, duration: 0.4 }, LOOP_AT);
        tl.fromTo(dot, { opacity: 0 }, { opacity: 0.95, duration: 0.15 }, LOOP_AT + 0.2);
        tl.fromTo(
          prog,
          { p: 0 },
          {
            p: 1,
            duration: 1.2,
            ease: 'none',
            onUpdate() {
              const pt = arc.getPointAtLength(prog.p * len);
              gsap.set(dot, { attr: { cx: pt.x, cy: pt.y } });
            },
          },
          LOOP_AT + 0.2,
        );
        tl.to(dot, { opacity: 0, duration: 0.2 }, LOOP_AT + 1.4);
        tl.fromTo(
          '.ha-event-loop',
          { opacity: 0, y: 8 },
          { opacity: 0.9, y: 0, duration: 0.3 },
          LOOP_AT + 0.7,
        );
        const visit = nodeEl('visit');
        if (visit) {
          tl.fromTo(
            visit,
            { scale: 1 },
            {
              keyframes: [
                { scale: 1.6, duration: 0.15, ease: 'power2.out' },
                { scale: 1, duration: 0.25, ease: 'power2.in' },
              ],
            },
            LOOP_AT + 1.3,
          );
        }
      }

      // 5) The bookend: the status read answers the POST.
      tl.fromTo(
        '.ha-status',
        { opacity: 0, y: 6 },
        { opacity: 0.95, y: 0, duration: 0.4 },
        LOOP_AT + 1.6,
      );

      // Scrub the whole thing to scroll: the reader completes the journey by
      // descending, and scrolling back up rewinds it.
      ScrollTrigger.create({
        animation: tl,
        trigger: art,
        start: 'top 82%',
        end: 'bottom 45%',
        scrub: 0.6,
      });
    } else {
      // Reduced motion: the completed journey as a still diagram.
      gsap.set('.ha-trail', { strokeDashoffset: 0, opacity: 0.45 });
      gsap.set('.ha-comet', { opacity: 0 });
      gsap.set('.ha-post', { opacity: 0.85 });
      gsap.set('.ha-status', { opacity: 0.85 });
      gsap.set('.ha-loop-path', { opacity: 0.45 });
      NODE_COORDS.forEach(([id]) => {
        const el = nodeEl(id);
        if (el) gsap.set(el, { fill: 'var(--pl-purple-500)', stroke: 'var(--pl-purple-500)' });
      });
      gsap.set('.ha-event-rx', { opacity: 0.9 });
      gsap.set('.ha-event-loop', { opacity: 0.7 });
    }
  }
</script>
