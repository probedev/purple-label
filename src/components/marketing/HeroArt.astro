---
/**
 * HeroArt — the patient saga, fired from the hero CTA (per Gregg 2026-07-25: "integrate
 * this animation into one of the hero CTA buttons, showing the journey automatically
 * and taking the client down the page").
 *
 * The hero's `POST /v1/orders` button (id="run-journey" in index.astro) IS the API
 * call: clicking it plays the ~8s journey while the viewport glides down in sync with
 * the comet (ScrollToPlugin, autoKill so a user wheel/touch cancels the glide), ending
 * on the completed journey and its `status: REFILL_DUE` bookend. If the reader scrolls
 * down organically instead, an IntersectionObserver plays the journey once — without
 * the auto-scroll — so the diagram never sits dead. Events stay lit after the run.
 * The old ECG jag lives on inside the pipe between visit and rx.
 *
 * Node timings are not hand-tuned: the script samples the path to find each node's
 * fraction of the total length, so geometry edits can't desync the pops. All colors
 * trace to design tokens (re-themes with light/dark). prefers-reduced-motion renders
 * the completed journey as a still diagram (the button then just scrolls to it).
 */

import { Icon } from 'astro-icon/components';

// Journey nodes ON the pipeline path below — cx/cy must sit on the path's segments.
// Each step gets its own icon medallion (per Gregg 2026-07-25): intake questions,
// money, ID, doctor, vial, shipment — and the refill cycle for follow-up.
const NODES = [
  { id: 'qualify', label: '01 qualify', icon: 'clipboard-list', cx: 420, cy: 120 },
  { id: 'pay', label: '02 pay', icon: 'circle-dollar-sign', cx: 280, cy: 120 },
  { id: 'verify', label: '03 verify id', icon: 'id-card', cx: 140, cy: 120 },
  { id: 'visit', label: '04 visit', icon: 'stethoscope', cx: 160, cy: 290 },
  { id: 'rx', label: '05 rx', icon: 'test-tube', cx: 320, cy: 290 },
  { id: 'deliver', label: '06 deliver', icon: 'truck', cx: 440, cy: 290 },
  { id: 'follow', label: '07 follow-up', icon: 'refresh-cw', cx: 300, cy: 460 },
];

// Event chips that light up as the comet passes — the platform's canonical event names.
// They stay lit once fired, so the journey accumulates an event log as you descend.
const EVENTS = [
  { node: 'qualify', text: 'patient.qualified', x: 420, y: 96 },
  { node: 'pay', text: 'payment.captured', x: 280, y: 96 },
  { node: 'visit', text: 'visit.completed', x: 160, y: 266 },
  { node: 'rx', text: 'rx.prescribed', x: 320, y: 264 },
  { node: 'deliver', text: 'shipment.updated', x: 440, y: 264 },
];

// Tall serpentine, top-right to bottom: down from the POST chip, row 1 right-to-left,
// down the left edge, row 2 left-to-right (with the ECG jag), down the right edge,
// row 3 back to the follow-up. pathLength=1000 normalizes dash math.
const PIPE =
  'M500,16 V90 Q500,120 470,120 H110 Q80,120 80,150 V260 Q80,290 110,290 H198 l10,-24 l10,40 l8,-16 H470 Q500,290 500,320 V430 Q500,460 470,460 H260';

// The refill loop: follow-up arcs back up the left side to the visit node.
const LOOP = 'M300,460 Q40,430 152,302';
---

<div class="hero-art" aria-hidden="true">
  <svg class="ha-flow" viewBox="0 0 640 535" fill="none" preserveAspectRatio="xMidYMid meet">
    <g class="ha-cycle">
      {/* the pipe: faint track, scroll-drawn trail, and the traveling comet */}
      <path class="ha-track" d={PIPE} pathLength="1000"></path>
      <path class="ha-trail" d={PIPE} pathLength="1000"></path>
      <path class="ha-comet" d={PIPE} pathLength="1000"></path>

      {
        /* the wire from the Patient journey button to the pipe entrance — its `d` is
          computed from live layout at load/resize. The faint track anchors the pipe
          to the button at all times; the bright layer draws on play, then settles
          into the same purple as the drawn pipe. */
      }
      <path class="ha-lead-track"></path>
      <path class="ha-lead"></path>

      {/* the refill loop back to the visit */}
      <path class="ha-loop-path" d={LOOP}></path>
      <circle class="ha-loop-dot" r="4"></circle>
      <text class="ha-mono ha-event ha-event-loop" x="120" y="400" text-anchor="middle"
        >order.titrated</text
      >

      {/* the journey's answer — the status read, at the bottom */}
      <g class="ha-status">
        <rect x="330" y="488" width="172" height="26" rx="7"></rect>
        <text class="ha-mono ha-status-text" x="340" y="505">status: REFILL_DUE</text>
      </g>

      {/* journey nodes: icon medallions + their always-on step labels */}
      {
        NODES.map((n) => (
          <g>
            <g class={`ha-nodeg ha-nodeg-${n.id}`}>
              <circle class={`ha-node ha-node-${n.id}`} cx={n.cx} cy={n.cy} r="14" />
              <Icon
                name={`lucide:${n.icon}`}
                class={`icon ha-node-icon ha-icon-${n.id}`}
                x={n.cx - 9}
                y={n.cy - 9}
                width={18}
                height={18}
              />
            </g>
            <text class="ha-mono ha-step" x={n.cx} y={n.cy + 34} text-anchor="middle">
              {n.label}
            </text>
          </g>
        ))
      }

      {/* event chips that accumulate as the comet passes */}
      {
        EVENTS.map((e) => (
          <text class={`ha-mono ha-event ha-event-${e.node}`} x={e.x} y={e.y} text-anchor="middle">
            {e.text}
          </text>
        ))
      }
    </g>
  </svg>
</div>

<style>
  /* A centered block that sizes to its container's width at the diagram's own 640:535
     aspect ratio — a tall-but-dense descent, not a background. */
  .hero-art {
    position: relative;
    width: 100%;
    pointer-events: none;
  }

  .ha-flow {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* ---- pipeline --------------------------------------------------------- */
  /* NOTE: no vector-effect here on purpose — non-scaling-stroke makes Chromium
     compute dashes in screen px, which desyncs dash-driven draws from
     geometry-derived timings (the "line trails the pops" bug). */
  .ha-track,
  .ha-trail,
  .ha-comet,
  .ha-loop-path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ha-track {
    stroke: var(--pl-purple-400);
    stroke-width: 1.25;
    opacity: 0.16;
  }
  .ha-trail {
    stroke: var(--pl-purple-500);
    stroke-width: 1.25;
    opacity: 0.55;
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000; /* drawn by scroll */
    will-change: stroke-dashoffset;
  }
  .ha-comet {
    stroke: var(--pl-teal-500);
    stroke-width: 2;
    opacity: 0.9;
    /* A 30/1000 lit window. At offset 30 the window sits BEFORE the path start, so
       nothing is lit while idle; animating 30 → -970 keeps the window's head locked
       to the trail's draw front, so node pops land exactly when the line arrives. */
    stroke-dasharray: 30 970;
    stroke-dashoffset: 30;
    will-change: stroke-dashoffset;
  }
  .ha-lead-track {
    fill: none;
    stroke: var(--pl-purple-400);
    stroke-width: 1.25;
    stroke-linecap: round;
    opacity: 0.16; /* the always-on anchor to the button */
  }
  .ha-lead {
    fill: none;
    stroke: var(--pl-teal-500);
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0; /* drawn on play; settles purple afterwards */
  }
  .ha-loop-path {
    stroke: var(--pl-teal-500);
    stroke-width: 1;
    stroke-dasharray: 5 7;
    opacity: 0; /* fades in when the refill loop runs */
  }
  .ha-loop-dot {
    fill: var(--pl-teal-500);
    opacity: 0;
  }

  /* ---- nodes & type ------------------------------------------------------ */
  .ha-nodeg {
    transform-box: fill-box;
    transform-origin: center;
  }
  .ha-node {
    fill: var(--pl-paper);
    stroke: var(--pl-purple-400);
    stroke-width: 1.5;
    opacity: 0.95;
  }
  .ha-node-icon {
    color: var(--pl-ink-400);
    opacity: 0.9;
  }
  .ha-mono {
    font-family: var(--font-mono);
  }
  .ha-step {
    font-size: 12px;
    fill: var(--pl-ink-400);
    opacity: 0.75;
  }
  .ha-event {
    font-size: 12px;
    font-weight: 600;
    fill: var(--pl-teal-600);
    opacity: 0; /* lit as the comet passes; stays lit */
  }
  .ha-status rect {
    fill: var(--pl-surface);
    stroke: var(--pl-line);
    stroke-width: 1;
  }
  .ha-status-text {
    font-size: 13px;
    font-weight: 600;
    fill: var(--pl-teal-600);
  }
  .ha-status {
    opacity: 0; /* the journey's final beat */
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollToPlugin } from 'gsap/ScrollToPlugin';

  const motionOk = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const art = document.querySelector('.hero-art');
  const runBtn = document.getElementById('run-journey');

  // Same ids/coords as NODES in the template (duplicated — template values don't reach
  // the client script). Times are NOT hand-tuned: each node's moment is found by
  // sampling the path for the closest point.
  const NODE_COORDS: Array<[string, number, number]> = [
    ['qualify', 420, 120],
    ['pay', 280, 120],
    ['verify', 140, 120],
    ['visit', 160, 290],
    ['rx', 320, 290],
    ['deliver', 440, 290],
    ['follow', 300, 460],
  ];
  const EVENT_NODES = ['qualify', 'pay', 'visit', 'rx', 'deliver'];

  const DRAW_AT = 0.55; // the request wire from the button lands first
  const DRAW_DUR = 6;
  const LOOP_AT = DRAW_AT + DRAW_DUR + 0.3;

  if (art) {
    const q = (sel: string) => art.querySelector(sel);
    const nodeEl = (id: string) => q(`.ha-node-${id}`);
    const trail = q('.ha-trail') as SVGPathElement | null;

    /** Fraction (0–1) of the pipe's length nearest to a point — no hand-tuned timings. */
    const fracAt = (cx: number, cy: number): number => {
      if (!trail) return 0;
      const total = trail.getTotalLength();
      const SAMPLES = 600;
      let best = 0;
      let bestDist = Infinity;
      for (let i = 0; i <= SAMPLES; i++) {
        const pt = trail.getPointAtLength((total * i) / SAMPLES);
        const d = (pt.x - cx) ** 2 + (pt.y - cy) ** 2;
        if (d < bestDist) {
          bestDist = d;
          best = i / SAMPLES;
        }
      }
      return best;
    };

    if (motionOk && trail) {
      gsap.registerPlugin(ScrollToPlugin);

      const tl = gsap.timeline({ paused: true });

      // 1) The pipe draws; the comet rides its front.
      tl.fromTo(
        '.ha-trail',
        { strokeDashoffset: 1000 },
        { strokeDashoffset: 0, duration: DRAW_DUR, ease: 'none' },
        DRAW_AT,
      ).fromTo(
        '.ha-comet',
        { strokeDashoffset: 30, opacity: 0.9 },
        { strokeDashoffset: -970, duration: DRAW_DUR, ease: 'none' },
        DRAW_AT,
      );
      tl.to('.ha-comet', { opacity: 0, duration: 0.3 }, DRAW_AT + DRAW_DUR);

      // 2) Nodes pop as the front arrives; events light and STAY lit — the completed
      //    journey remains on the page as an event log. Fills switch via set()
      //    (GSAP can't interpolate var() colors).
      NODE_COORDS.forEach(([id, cx, cy]) => {
        const el = nodeEl(id);
        if (!el) return;
        const at = DRAW_AT + fracAt(cx, cy) * DRAW_DUR;
        tl.set(el, { fill: 'var(--pl-purple-500)', stroke: 'var(--pl-purple-500)' }, at);
        tl.set(`.ha-icon-${id}`, { color: 'var(--pl-purple-50)' }, at);
        tl.fromTo(
          `.ha-nodeg-${id}`,
          { scale: 1 },
          {
            keyframes: [
              { scale: 1.15, duration: 0.12, ease: 'power1.out' },
              { scale: 1, duration: 0.22, ease: 'power1.in' },
            ],
            transformOrigin: 'center',
            duration: 0.34,
          },
          at,
        );
        if (EVENT_NODES.includes(id)) {
          tl.fromTo(
            `.ha-event-${id}`,
            { opacity: 0, y: 8 },
            { opacity: 0.95, y: 0, duration: 0.3 },
            at + 0.05,
          );
        }
      });

      // 3) The refill loop: the dashed arc appears, a dot rides it back up to the
      //    visit node, order.titrated lights — care is a cycle.
      const arc = q('.ha-loop-path') as SVGPathElement | null;
      const dot = q('.ha-loop-dot');
      if (arc && dot) {
        const len = arc.getTotalLength();
        const prog = { p: 0 };
        tl.fromTo('.ha-loop-path', { opacity: 0 }, { opacity: 0.55, duration: 0.4 }, LOOP_AT);
        tl.fromTo(dot, { opacity: 0 }, { opacity: 0.95, duration: 0.15 }, LOOP_AT + 0.2);
        tl.fromTo(
          prog,
          { p: 0 },
          {
            p: 1,
            duration: 1.1,
            ease: 'power1.inOut',
            onUpdate() {
              const pt = arc.getPointAtLength(prog.p * len);
              gsap.set(dot, { attr: { cx: pt.x, cy: pt.y } });
            },
          },
          LOOP_AT + 0.2,
        );
        tl.to(dot, { opacity: 0, duration: 0.2 }, LOOP_AT + 1.3);
        tl.fromTo(
          '.ha-event-loop',
          { opacity: 0, y: 8 },
          { opacity: 0.9, y: 0, duration: 0.3 },
          LOOP_AT + 0.6,
        );
        tl.fromTo(
          '.ha-nodeg-visit',
          { scale: 1 },
          {
            keyframes: [
              { scale: 1.15, duration: 0.12, ease: 'power1.out' },
              { scale: 1, duration: 0.22, ease: 'power1.in' },
            ],
            transformOrigin: 'center',
          },
          LOOP_AT + 1.2,
        );
      }

      // 4) The bookend: the status read answers the POST.
      tl.fromTo(
        '.ha-status',
        { opacity: 0, y: 6 },
        { opacity: 0.95, y: 0, duration: 0.4 },
        LOOP_AT + 1.5,
      );

      // The wire from the button to the pipe entrance. Its path is computed from the
      // button's live position (mapped into SVG user coords) at load and on resize, so
      // the pipe is visibly anchored to the button at ALL times via the faint track.
      // On play, the bright layer draws along it, then settles into the pipe's purple.
      const lead = q('.ha-lead') as SVGPathElement | null;
      const leadTrack = q('.ha-lead-track') as SVGPathElement | null;
      const svg = art.querySelector('svg') as SVGSVGElement | null;

      const layoutWire = () => {
        if (!lead || !leadTrack || !svg || !runBtn) return;
        const ctm = svg.getScreenCTM();
        if (!ctm) return;
        const inv = ctm.inverse();
        const r = runBtn.getBoundingClientRect();
        const p = new DOMPoint(r.left + r.width / 2, r.bottom - 4).matrixTransform(inv);
        const d = `M${p.x.toFixed(1)},${p.y.toFixed(1)} C${p.x.toFixed(1)},${(p.y + 70).toFixed(1)} 500,-80 500,16`;
        lead.setAttribute('d', d);
        leadTrack.setAttribute('d', d);
      };
      layoutWire();
      let resizeTimer: ReturnType<typeof setTimeout> | undefined;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(layoutWire, 150);
      });

      const fireWire = () => {
        if (!lead) return;
        layoutWire(); // fresh coords in case anything moved since load
        const len = lead.getTotalLength();
        gsap.killTweensOf(lead);
        gsap.set(lead, {
          stroke: 'var(--pl-teal-500)',
          strokeDasharray: len,
          strokeDashoffset: len,
          opacity: 0.85,
        });
        gsap.to(lead, { strokeDashoffset: 0, duration: 0.5, ease: 'power1.in' });
        // Settle: the wire joins the drawn pipe instead of vanishing.
        gsap.set(lead, { stroke: 'var(--pl-purple-500)', delay: 0.9 });
        gsap.to(lead, { opacity: 0.5, duration: 0.5, delay: 0.9 });
      };

      let played = false;
      const play = () => {
        played = true;
        fireWire();
        tl.restart();
      };

      // Organic path: reader scrolls the diagram into view themselves → the journey
      // plays once, without taking over their scroll. Armed only after the first real
      // scroll, so nothing looks "already selected" on a fresh page load.
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting) && !played) {
            play();
            io.disconnect();
          }
        },
        { threshold: 0.35 },
      );
      window.addEventListener('scroll', () => io.observe(art), { once: true, passive: true });

      // The hero CTA path: POST /v1/orders fires the journey AND glides the viewport
      // down in sync with the comet. autoKill hands control back the moment the
      // reader scrolls on their own.
      runBtn?.addEventListener('click', () => {
        play();
        const rect = (art as HTMLElement).getBoundingClientRect();
        const targetY = window.scrollY + rect.bottom - window.innerHeight * 0.85;
        gsap.to(window, {
          scrollTo: { y: targetY, autoKill: true },
          duration: tl.duration() * 0.9,
          ease: 'power1.inOut',
        });
      });
    } else {
      // Reduced motion: the completed journey as a still diagram; the button simply
      // brings it into view.
      gsap.set('.ha-trail', { strokeDashoffset: 0, opacity: 0.45 });
      gsap.set('.ha-comet', { opacity: 0 });
      gsap.set('.ha-status', { opacity: 0.85 });
      gsap.set('.ha-loop-path', { opacity: 0.45 });
      NODE_COORDS.forEach(([id]) => {
        const el = nodeEl(id);
        if (el) gsap.set(el, { fill: 'var(--pl-purple-500)', stroke: 'var(--pl-purple-500)' });
        gsap.set(`.ha-icon-${id}`, { color: 'var(--pl-purple-50)' });
      });
      gsap.set('.ha-event-rx', { opacity: 0.9 });
      gsap.set('.ha-event-loop', { opacity: 0.7 });
      // Anchor the completed diagram to the button, statically.
      const leadStill = q('.ha-lead') as SVGPathElement | null;
      const trackStill = q('.ha-lead-track') as SVGPathElement | null;
      const svgStill = art.querySelector('svg') as SVGSVGElement | null;
      if (leadStill && trackStill && svgStill && runBtn) {
        const ctm = svgStill.getScreenCTM();
        if (ctm) {
          const r = runBtn.getBoundingClientRect();
          const p = new DOMPoint(r.left + r.width / 2, r.bottom - 4).matrixTransform(ctm.inverse());
          const d = `M${p.x.toFixed(1)},${p.y.toFixed(1)} C${p.x.toFixed(1)},${(p.y + 70).toFixed(1)} 500,-80 500,16`;
          leadStill.setAttribute('d', d);
          trackStill.setAttribute('d', d);
          gsap.set(leadStill, { stroke: 'var(--pl-purple-500)', opacity: 0.45 });
        }
      }
      runBtn?.addEventListener('click', () => {
        (art as HTMLElement).scrollIntoView({ block: 'center' });
      });
    }
  }
</script>
