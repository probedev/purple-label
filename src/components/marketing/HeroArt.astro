---
/**
 * HeroArt — the patient saga as a living flow diagram (per Gregg 2026-07-23, replacing
 * the pill-pile gag: same muted palette and non-distracting energy, but targeted — it
 * shows the value, a complex patient journey simplified behind one API call).
 *
 * One cycle: a `POST /v1/orders` chip fires → a comet draws the serpentine pipeline
 * through the seven journey steps (qualify → pay → verify → visit → rx → deliver →
 * follow-up) → each node pops and emits its real platform event name (the same set
 * /architecture and /developers publish) → the refill loop arcs back to the visit with
 * `order.titrated` → the whole thing fades and repeats. The ECG jag from the old hero
 * lives on inside the pipe between visit and rx.
 *
 * Every color traces to design tokens (re-themes with light/dark). GSAP-driven, gated on
 * prefers-reduced-motion (which shows the completed pipeline as a still diagram).
 * Right-weighted and masked to fade toward the copy.
 */

// Journey nodes ON the pipeline path below — cx/cy must sit on the path's segments.
// `t` = seconds after draw start when the comet front reaches the node (computed from
// each node's share of the path's total length; keep in sync if the path changes).
const NODES = [
  { id: 'qualify', label: '01 qualify', cx: 100, cy: 70, t: 0.36 },
  { id: 'pay', label: '02 pay', cx: 280, cy: 70, t: 1.42 },
  { id: 'verify', label: '03 verify id', cx: 440, cy: 70, t: 2.37 },
  { id: 'visit', label: '04 visit', cx: 440, cy: 200, t: 3.66 },
  { id: 'rx', label: '05 rx', cx: 300, cy: 200, t: 4.83 },
  { id: 'deliver', label: '06 deliver', cx: 140, cy: 200, t: 5.77 },
  { id: 'follow', label: '07 follow-up', cx: 260, cy: 330, t: 7.76 },
];

// The event chips that pop as the comet passes — the platform's canonical event names.
const EVENTS = [
  { node: 'qualify', text: 'patient.qualified', x: 100, y: 48 },
  { node: 'pay', text: 'payment.captured', x: 280, y: 48 },
  { node: 'visit', text: 'visit.completed', x: 440, y: 176 },
  { node: 'rx', text: 'rx.prescribed', x: 300, y: 178 },
  { node: 'deliver', text: 'shipment.updated', x: 140, y: 178 },
];

// Serpentine pipeline: row 1 rightward, down, row 2 leftward (with the ECG jag),
// down, row 3 rightward to the follow-up. pathLength=1000 normalizes dash math.
const PIPE =
  'M40,70 H460 Q500,70 500,110 V160 Q500,200 460,200 H408 l-10,-24 l-10,40 l-8,-16 H120 Q80,200 80,240 V290 Q80,330 120,330 H300';

// The refill loop: follow-up arcs back up to the visit node.
const LOOP = 'M260,330 Q600,318 448,212';
---

<div class="hero-art" aria-hidden="true">
  <svg class="ha-flow" viewBox="0 0 640 400" fill="none" preserveAspectRatio="xMaxYMid meet">
    <g class="ha-cycle">
      {/* the pipe: faint track, drawn trail, and the traveling comet */}
      <path class="ha-track" d={PIPE} pathLength="1000"></path>
      <path class="ha-trail" d={PIPE} pathLength="1000"></path>
      <path class="ha-comet" d={PIPE} pathLength="1000"></path>

      {/* the refill loop back to the visit */}
      <path class="ha-loop-path" d={LOOP}></path>
      <circle class="ha-loop-dot" r="4"></circle>
      <text class="ha-mono ha-event ha-event-loop" x="480" y="298" text-anchor="middle"
        >order.titrated</text
      >

      {/* the API call that starts it all */}
      <g class="ha-post">
        <rect x="20" y="8" width="152" height="26" rx="7"></rect>
        <text class="ha-mono ha-post-text" x="30" y="25">POST /v1/orders</text>
      </g>

      {/* journey nodes + their always-on step labels */}
      {
        NODES.map((n) => (
          <g>
            <circle class={`ha-node ha-node-${n.id}`} cx={n.cx} cy={n.cy} r="5" />
            <text class="ha-mono ha-step" x={n.cx} y={n.cy + 24} text-anchor="middle">
              {n.label}
            </text>
          </g>
        ))
      }

      {/* event chips that pop as the comet passes */}
      {
        EVENTS.map((e) => (
          <text class={`ha-mono ha-event ha-event-${e.node}`} x={e.x} y={e.y} text-anchor="middle">
            {e.text}
          </text>
        ))
      }
    </g>
  </svg>
</div>

<style>
  /* Right-weighted canvas, faded toward the copy so the headline stays clean. */
  .hero-art {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(105deg, transparent 2%, transparent 26%, #000 60%);
    mask-image: linear-gradient(105deg, transparent 2%, transparent 26%, #000 60%);
  }

  .ha-flow {
    position: absolute;
    top: 50%;
    right: 0;
    width: 78%;
    height: 96%;
    transform: translateY(-50%);
    overflow: visible;
  }

  /* ---- pipeline --------------------------------------------------------- */
  .ha-track,
  .ha-trail,
  .ha-comet,
  .ha-loop-path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .ha-track {
    stroke: var(--pl-purple-400);
    stroke-width: 2;
    opacity: 0.16;
  }
  .ha-trail {
    stroke: var(--pl-purple-500);
    stroke-width: 2;
    opacity: 0.55;
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000; /* drawn on by GSAP */
    will-change: stroke-dashoffset;
  }
  .ha-comet {
    stroke: var(--pl-teal-500);
    stroke-width: 3;
    opacity: 0.9;
    stroke-dasharray: 30 970; /* a 30/1000 lit window — the traveling front */
    stroke-dashoffset: 0;
    will-change: stroke-dashoffset;
  }
  .ha-loop-path {
    stroke: var(--pl-teal-500);
    stroke-width: 1.5;
    stroke-dasharray: 5 7;
    opacity: 0; /* fades in when the refill loop runs */
  }
  .ha-loop-dot {
    fill: var(--pl-teal-500);
    opacity: 0;
  }

  /* ---- nodes & type ------------------------------------------------------ */
  .ha-node {
    fill: var(--pl-paper);
    stroke: var(--pl-purple-400);
    stroke-width: 2;
    opacity: 0.9;
    transform-box: fill-box;
    transform-origin: center;
  }
  .ha-mono {
    font-family: var(--font-mono);
  }
  .ha-step {
    font-size: 11px;
    fill: var(--pl-ink-400);
    opacity: 0.75;
  }
  .ha-event {
    font-size: 11px;
    font-weight: 600;
    fill: var(--pl-teal-600);
    opacity: 0; /* popped by GSAP as the comet passes */
  }
  .ha-post rect {
    fill: var(--pl-surface);
    stroke: var(--pl-line);
    stroke-width: 1;
  }
  .ha-post-text {
    font-size: 12px;
    font-weight: 600;
    fill: var(--pl-purple-600);
  }
  .ha-post {
    opacity: 0; /* faded in at cycle start */
  }
</style>

<script>
  import gsap from 'gsap';

  const motionOk = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const art = document.querySelector('.hero-art');

  // Seconds after draw start when the comet front reaches each node — keep in sync
  // with NODES in the template (same numbers, duplicated because template values
  // don't reach the client script).
  const NODE_TIMES: Array<[string, number]> = [
    ['qualify', 0.36],
    ['pay', 1.42],
    ['verify', 2.37],
    ['visit', 3.66],
    ['rx', 4.83],
    ['deliver', 5.77],
    ['follow', 7.76],
  ];
  const EVENT_NODES = ['qualify', 'pay', 'visit', 'rx', 'deliver'];

  const DRAW_AT = 0.6; // the POST chip lands first, then the pipe draws
  const DRAW_DUR = 8;
  const LOOP_AT = DRAW_AT + DRAW_DUR + 0.4; // the refill loop, after the pipe completes

  if (art) {
    const q = (sel: string) => art.querySelector(sel);
    const nodeEl = (id: string) => q(`.ha-node-${id}`);

    if (motionOk) {
      const tl = gsap.timeline({ repeat: -1, repeatDelay: 0.9 });

      // 1) The API call lands.
      tl.fromTo('.ha-post', { opacity: 0, y: 6 }, { opacity: 0.9, y: 0, duration: 0.5 }, 0);

      // 2) The pipe draws while the comet rides its front (both ease:none so the
      //    node timings below stay exact).
      tl.fromTo(
        '.ha-trail',
        { strokeDashoffset: 1000 },
        { strokeDashoffset: 0, duration: DRAW_DUR, ease: 'none' },
        DRAW_AT,
      ).fromTo(
        '.ha-comet',
        { strokeDashoffset: 0, opacity: 0.9 },
        { strokeDashoffset: -970, duration: DRAW_DUR, ease: 'none' },
        DRAW_AT,
      );
      tl.to('.ha-comet', { opacity: 0, duration: 0.35 }, DRAW_AT + DRAW_DUR);

      // 3) Nodes pop as the front arrives; the real event names float up and fade.
      // Fills switch via set() (GSAP can't interpolate var() colors) — the scale pop
      // carries the motion. The t=0 set() restores the resting fill on every loop.
      NODE_TIMES.forEach(([id, t]) => {
        const el = nodeEl(id);
        if (!el) return;
        const at = DRAW_AT + t;
        tl.set(el, { fill: 'var(--pl-paper)', stroke: 'var(--pl-purple-400)' }, 0);
        tl.set(el, { fill: 'var(--pl-purple-500)', stroke: 'var(--pl-purple-500)' }, at);
        tl.fromTo(
          el,
          { scale: 1 },
          {
            keyframes: [
              { scale: 1.55, duration: 0.18, ease: 'power2.out' },
              { scale: 1, duration: 0.3, ease: 'power2.in' },
            ],
            transformOrigin: 'center',
            duration: 0.48,
          },
          at,
        );
        if (EVENT_NODES.includes(id)) {
          tl.fromTo(
            `.ha-event-${id}`,
            { opacity: 0, y: 8 },
            { opacity: 0.95, y: 0, duration: 0.3 },
            at + 0.05,
          ).to(`.ha-event-${id}`, { opacity: 0, duration: 0.5 }, at + 2.1);
        }
      });

      // 4) The refill loop: the dashed arc appears, a dot rides it back to the visit
      //    node, order.titrated pops, and the visit re-fires — care is a cycle.
      const arc = q('.ha-loop-path') as SVGPathElement | null;
      const dot = q('.ha-loop-dot');
      if (arc && dot) {
        const len = arc.getTotalLength();
        const prog = { p: 0 };
        tl.fromTo('.ha-loop-path', { opacity: 0 }, { opacity: 0.55, duration: 0.5 }, LOOP_AT);
        tl.fromTo(dot, { opacity: 0 }, { opacity: 0.95, duration: 0.2 }, LOOP_AT + 0.3);
        tl.fromTo(
          prog,
          { p: 0 },
          {
            p: 1,
            duration: 1.8,
            ease: 'power1.inOut',
            onUpdate() {
              const pt = arc.getPointAtLength(prog.p * len);
              gsap.set(dot, { attr: { cx: pt.x, cy: pt.y } });
            },
          },
          LOOP_AT + 0.3,
        );
        tl.to(dot, { opacity: 0, duration: 0.25 }, LOOP_AT + 2.1);
        tl.fromTo(
          '.ha-event-loop',
          { opacity: 0, y: 8 },
          { opacity: 0.9, y: 0, duration: 0.3 },
          LOOP_AT + 0.9,
        ).to('.ha-event-loop', { opacity: 0, duration: 0.5 }, LOOP_AT + 2.6);
        const visit = nodeEl('visit');
        if (visit) {
          tl.fromTo(
            visit,
            { scale: 1 },
            {
              keyframes: [
                { scale: 1.55, duration: 0.18, ease: 'power2.out' },
                { scale: 1, duration: 0.3, ease: 'power2.in' },
              ],
            },
            LOOP_AT + 2.0,
          );
        }
      }

      // 5) Hold the completed journey a beat, then fade the cycle out and repeat.
      tl.set('.ha-cycle', { opacity: 1 }, 0);
      tl.to('.ha-cycle', { opacity: 0, duration: 0.7 }, LOOP_AT + 3.4);
    } else {
      // Reduced motion: the completed pipeline as a still diagram — pipe drawn, nodes
      // lit, refill loop visible, two event chips shown so the diagram reads as alive.
      gsap.set('.ha-trail', { strokeDashoffset: 0, opacity: 0.45 });
      gsap.set('.ha-comet', { opacity: 0 });
      gsap.set('.ha-post', { opacity: 0.85 });
      gsap.set('.ha-loop-path', { opacity: 0.45 });
      NODE_TIMES.forEach(([id]) => {
        const el = nodeEl(id);
        if (el) gsap.set(el, { fill: 'var(--pl-purple-500)', stroke: 'var(--pl-purple-500)' });
      });
      gsap.set('.ha-event-rx', { opacity: 0.9 });
      gsap.set('.ha-event-loop', { opacity: 0.7 });
    }
  }
</script>
