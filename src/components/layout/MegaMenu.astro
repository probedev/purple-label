---
/**
 * MegaMenu — one desktop nav group (§5.3), shadcn-style detail dropdown. Trigger links to
 * the group overview; the panel reveals on hover and on keyboard focus-within (200ms fade +
 * rise). Each item is icon + title + one-line description; a footer link returns the overview.
 * Groups with >6 items render a wider 3-column panel (e.g. Rx).
 */
import { Icon } from 'astro-icon/components';
import type { NavGroup } from '../../lib/nav';

interface Props {
  group: NavGroup;
}
const { group } = Astro.props;
const triggerHref = group.href ?? group.items[0]?.href ?? '#';
const wide = group.items.length > 6;
---

<li class="group relative">
  <a
    href={triggerHref}
    class="inline-flex h-11 items-center gap-1 rounded-md px-3 text-sm font-semibold text-ink-700 transition-colors duration-150 hover:text-purple-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-500"
    aria-haspopup="true"
  >
    {group.label}
    <Icon
      name="lucide:chevron-down"
      class="icon size-4 transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180"
    />
  </a>

  <div
    class:list={[
      'invisible absolute left-0 top-full z-40 translate-y-1 pt-2 opacity-0 transition duration-200 ease-out group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100',
      wide ? 'w-180' : 'w-144',
    ]}
  >
    <div class="rounded-lg border border-line bg-surface p-2 shadow-md">
      <ul class:list={['grid grid-cols-1 gap-1', wide ? 'sm:grid-cols-3' : 'sm:grid-cols-2']}>
        {
          group.items.map((item) => (
            <li>
              <a
                href={item.href}
                class="flex items-start gap-3 rounded-md p-3 transition-colors duration-150 hover:bg-surface-sunken focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-500"
              >
                {item.icon && (
                  <Icon
                    name={`lucide:${item.icon}`}
                    class="icon mt-0.5 size-5 shrink-0 text-purple-600"
                  />
                )}
                <span class="min-w-0">
                  <span class="block text-sm font-semibold text-ink-900">{item.label}</span>
                  {item.desc && <span class="mt-0.5 block text-xs text-ink-400">{item.desc}</span>}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      {
        group.href && (
          <div class="mt-1 border-t border-line pt-1">
            <a
              href={group.href}
              class="flex items-center justify-between rounded-md p-3 text-sm font-semibold text-purple-600 transition-colors duration-150 hover:bg-surface-sunken focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-500"
            >
              <span>Explore {group.label}</span>
              <Icon name="lucide:arrow-right" class="icon size-4" />
            </a>
          </div>
        )
      }
    </div>
  </div>
</li>
