---
/**
 * Footer — design.md §5.4. Always-dark anchor: 4 nav columns, a trust row (badges from
 * TRUST_BADGES; SOC 2 always qualified as in-progress), and a bottom bar. Purple link
 * hovers. Status pill removed per CONTENT-REVIEW-2026-07-21 C18.
 */
import Container from './Container.astro';
import Logo from './Logo.astro';
import { FOOTER_COLUMNS, TRUST_BADGES } from '../../lib/nav';
import { SITE } from '../../lib/seo';

const year = 2026; // build-time constant; bump in CI if desired
---

<footer class="bg-dark-bg text-dark-fg">
  <Container as="div" class="py-16 md:py-24">
    <div class="grid grid-cols-2 gap-x-8 gap-y-12 md:grid-cols-3 lg:grid-cols-5">
      <!-- Brand column -->
      <div class="col-span-2 lg:col-span-1">
        <Logo invert />
        <p class="mt-4 max-w-prose text-sm text-dark-fg-muted">{SITE.tagline}</p>
      </div>

      {
        FOOTER_COLUMNS.map((col) => (
          <nav aria-label={col.label}>
            <h2 class="font-display text-xs font-semibold uppercase tracking-eyebrow text-dark-fg-muted">
              {col.label}
            </h2>
            <ul class="mt-4 flex flex-col gap-3">
              {col.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="text-sm text-dark-fg transition-colors duration-150 hover:text-purple-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-400"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <!-- Trust row -->
    <div
      class="mt-16 flex flex-col gap-6 border-t border-dark-line pt-8 md:flex-row md:items-center md:justify-between"
    >
      <ul class="flex flex-wrap items-center gap-x-6 gap-y-3">
        {
          TRUST_BADGES.map((badge) => (
            <li class="text-sm font-semibold text-dark-fg">
              {badge.label}
              {badge.status === 'in-progress' && (
                <span class="ml-1 font-normal text-dark-fg-muted">(in progress)</span>
              )}
            </li>
          ))
        }
      </ul>
      {
        /* Status pill removed per review G3/C18 — an evergreen-static "operational"
          claim is a fake signal. Restore only wired to a real status provider. */
      }
    </div>

    <!-- Bottom bar -->
    <div
      class="mt-8 flex flex-col gap-3 text-xs text-dark-fg-muted sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {SITE.name}. All rights reserved.</p>
      <p>Built for protected health information from day one.</p>
    </div>
  </Container>
</footer>
