      'grid size-9 shrink-0 place-items-center rounded-lg border transition-colors duration-150',
      invert
        ? 'border-transparent bg-purple-600 text-white group-hover:bg-purple-700'
        : 'border-purple-200 bg-purple-50 text-purple-600 group-hover:bg-purple-100 dark:border-transparent dark:bg-purple-600 dark:text-white dark:group-hover:bg-purple-700',
    ]}
