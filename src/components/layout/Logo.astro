---
/**
 * Logo — brand lockup per the Purple Label MD brand guidelines: the carrot mark in a soft
 * purple-tint badge + the "purplelabelMD" wordmark (one word, lowercase Geist Semibold, tight
 * tracking, "MD" in brand purple). Carrot is inlined with fill="currentColor" so the badge can
 * recolor it. Light: tint badge + purple carrot. Dark theme / footer `invert`: brand-purple
 * badge + white carrot (the brand app-icon treatment).
 */
interface Props {
  /** Use on dark backgrounds (footer): brand-purple badge + white mark + light wordmark. */
  invert?: boolean;
  class?: string;
}
const { invert = false, class: className = '' } = Astro.props;
