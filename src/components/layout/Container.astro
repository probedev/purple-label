---
/**
 * Container — centers content at the §3.1 max width with fluid outer padding.
 * `wide` switches to the 1320px feature-canvas width.
 */
interface Props {
  wide?: boolean;
  as?: 'div' | 'section' | 'header' | 'footer' | 'nav' | 'main';
  class?: string;
}
const { wide = false, as: Tag = 'div', class: className = '' } = Astro.props;
---

<Tag
  class:list={[
    'mx-auto w-full px-5 sm:px-6 lg:px-8',
    wide ? 'max-w-wide' : 'max-w-content',
    className,
  ]}
>
  <slot />
</Tag>
