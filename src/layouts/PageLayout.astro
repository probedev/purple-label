---
/**
 * PageLayout — standard marketing page wrapper: Header + <main> + Footer over BaseLayout,
 * plus the mobile sticky consult bar and the site-wide lead-capture modal (every link to
 * /contact opens it). Pages that are themselves the conversion target (/contact,
 * /thank-you) pass hideStickyCta; /contact also skips the modal since it renders the
 * same card inline — that keeps the card's element ids unique per page.
 */
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import MobileStickyCta from '../components/layout/MobileStickyCta.astro';
import LeadModal from '../components/marketing/LeadModal.astro';
import type { SeoProps } from '../lib/seo';

type Props = SeoProps & { hideStickyCta?: boolean };

const { hideStickyCta = false, ...seo } = Astro.props;
const isContact = (Astro.url.pathname.replace(/\/+$/, '') || '/') === '/contact';
---

<BaseLayout {...seo}>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
  {!hideStickyCta && <MobileStickyCta />}
  {!isContact && <LeadModal />}
</BaseLayout>
