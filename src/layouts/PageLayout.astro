---
/**
 * PageLayout — standard marketing page wrapper: Header + <main> + Footer over BaseLayout,
 * plus the mobile sticky consult bar. Pages that are themselves the conversion target
 * (/contact, /thank-you) pass hideStickyCta.
 */
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import MobileStickyCta from '../components/layout/MobileStickyCta.astro';
import type { SeoProps } from '../lib/seo';

type Props = SeoProps & { hideStickyCta?: boolean };

const { hideStickyCta = false, ...seo } = Astro.props;
---

<BaseLayout {...seo}>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
  {!hideStickyCta && <MobileStickyCta />}
</BaseLayout>
