{
  // Cloudflare Workers — static-assets deploy of the Astro build output (dist/).
  // Used by `npx wrangler deploy` in Cloudflare Workers Builds. No `main` worker
  // script: this is an assets-only Worker (pure static site). `name` MUST match the
  // Worker that Cloudflare provisioned for this repo (it auto-generated this name);
  // it's internal-only — attach purplelabelmd.com as the custom domain in the
  // Cloudflare dashboard once content is launch-ready, and end users never see it.
  "name": "weathered-forest-66b6",
  "compatibility_date": "2026-06-26",
  "assets": {
    "directory": "./dist",
  },
}
