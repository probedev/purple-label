{
  // Cloudflare Workers — the Astro build output (dist/) served as static assets, plus a
  // small Worker (worker/index.js) that handles the /contact lead form at POST /api/lead.
  // `name` MUST match the Worker that Cloudflare provisioned for this repo (it
  // auto-generated this name); it's internal-only — attach purplelabelmd.com as the
  // custom domain in the Cloudflare dashboard once content is launch-ready.
  //
  // Lead-form go-live (one time):
  //   1. npx wrangler kv namespace create LEADS
  //   2. Uncomment kv_namespaces below and paste the id it prints.
  //   3. Set FORM_ENDPOINT = '/api/lead' in src/pages/contact.astro.
  //   4. npx wrangler deploy
  // Until then the worker answers 503 on /api/lead and the form's send button stays gated.
  "name": "weathered-forest-66b6",
  "main": "worker/index.js",
  "compatibility_date": "2026-06-26",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  // "kv_namespaces": [{ "binding": "LEADS", "id": "<paste the id from step 1>" }],
}
